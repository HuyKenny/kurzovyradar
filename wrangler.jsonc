{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Astro SSR (adapter) + our own entry: fetch → Astro with an edge cache, scheduled → odds import into D1.
  "name": "kurzovyradar",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "kurzovyradar.cz", "custom_domain": true },
    { "pattern": "www.kurzovyradar.cz", "custom_domain": true }
  ],
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "html_handling": "force-trailing-slash", "not_found_handling": "none" },
  // Secrets (wrangler secret put): TIPSPORT_CLIENT_ID/SECRET, CHANCE_API_USER/PASS. Values: ~/ai/credentials/.kurzovyradar-credentials.env
  // Every 15 min, offset from sportstreamy (which runs on */15): 2 requests per run (one bulk call per bookmaker).
  "triggers": { "crons": ["4,19,34,49 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "kurzovyradar", "database_id": "af52d462-e199-4497-8605-89f9a73e3c3e", "migrations_dir": "migrations" }],
  "vars": {
    "ENVIRONMENT": "production",
    // Partner links from Kenny (23. 10. 2026, KurzovýRadar's own placements: Tipsport sid 45940, Chance sid 45960).
    // Match deeplinks reuse pid/sid/bid/tid from these on the bookmaker's match path.
    "TIPSPORT_URL": "https://www.tipsport.cz/PartnerRedirectAction.do?pid=14361&sid=45940&bid=3550&tid=2121",
    "CHANCE_URL": "https://www.chance.cz/PartnerRedirectAction.do?pid=31094&sid=45960&bid=3550&tid=2121",
    "ALLWYN_URL": "https://record.sazka.cz/_8u72YyI1anJ_qrCCt62aAWNd7ZgqdRLk/1/",
    "MERKURXTIP_URL": "https://go.affilmaster.com/scripts/cdvy4d2?a_aid=TTE4W&a_bid=c708e3ae&data1=kurzovyradar",
    "IMPORT_INTERVAL_MIN": "15",
    "CACHE_TTL_S": "300",
    "STALE_AFTER_MIN": "45",
    "HISTORY_DAYS": "30",
    "START_TOLERANCE_MIN": "0",
    "WINDOW_DAYS": "7"
  },
  "analytics_engine_datasets": [{ "binding": "CLICKS", "dataset": "kurzovyradar_clicks" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
