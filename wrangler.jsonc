{
  "$schema": "node_modules/wrangler/config-schema.json",
  // LOCAL RENDERER ONLY (since 23. 11. 2026): `wrangler dev --local` of the Astro SSR app over the SQLite state; scheduled → odds import.
  // Production = static files + edge/worker.js, deployed by scripts/static.py from GitHub Actions. The name and the missing routes make an
  // accidental `wrangler deploy` of this config harmless: it can never replace the production Worker "kurzovyradar".
  "name": "kurzovyradar-render",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "html_handling": "force-trailing-slash", "not_found_handling": "none" },
  // Secrets in .dev.vars (written by scripts/static.py from the environment / GitHub secrets): TIPSPORT_CLIENT_ID/SECRET, CHANCE_API_USER/PASS.
  // Values: ~/ai/credentials/.kurzovyradar-credentials.env
  // No cron triggers: the import runs in GitHub Actions every 15 min (schedules drift, so the site says 20) (2 requests per run, one bulk call per bookmaker).
  // Local SQLite only (miniflare); the state lives encrypted in the GitHub release "state" (scripts/state.sh). The id is the old D1's.
  "d1_databases": [{ "binding": "DB", "database_name": "kurzovyradar", "database_id": "af52d462-e199-4497-8605-89f9a73e3c3e", "migrations_dir": "migrations" }],
  "vars": {
    "ENVIRONMENT": "production",
    // Partner links from Kenny (23. 10. 2026, KurzovýRadar's own placements: Tipsport sid 45940, Chance sid 45960).
    // Match deeplinks reuse pid/sid/bid/tid from these on the bookmaker's match path.
    "TIPSPORT_URL": "https://www.tipsport.cz/PartnerRedirectAction.do?pid=14361&sid=45940&bid=3550&tid=2121",
    "CHANCE_URL": "https://www.chance.cz/PartnerRedirectAction.do?pid=31094&sid=45960&bid=4666&tid=2703&urlid=681",
    "ALLWYN_URL": "https://record.sazka.cz/_8u72YyI1anJ_qrCCt62aAWNd7ZgqdRLk/1/",
    "MERKURXTIP_URL": "https://go.affilmaster.com/scripts/cdvy4d2?a_aid=TTE4W&a_bid=c708e3ae&data1=kurzovyradar",
    "IMPORT_INTERVAL_MIN": "20",
    "CACHE_TTL_S": "600",
    "STALE_AFTER_MIN": "60",
    "HISTORY_DAYS": "30",
    "START_TOLERANCE_MIN": "0",
    "WINDOW_DAYS": "7"
  },
  "observability": { "enabled": false }
}
