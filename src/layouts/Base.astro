---
import '../styles/app.css';
import { SITE, HELP, NAV } from '../config/site';
import { COMPETITIONS } from '../config/competitions';
import { PARTNERS } from '../config/bookmakers';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { demo } from '../lib/data';

export interface Crumb { name: string; url: string }
interface Props {
  title: string;
  description: string;
  /** Canonical path; defaults to the current path without query. */
  canonical?: string;
  noindex?: boolean;
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  og?: string;
  ogType?: string;
}
const { title, description, canonical: canon, noindex = false, crumbs = [], schema = [], og, ogType = 'website' } = Astro.props;
const isDemo = demo();
const path = Astro.url.pathname;
const canonical = new URL(canon ?? path, SITE.url).href;
const ogUrl = new URL(og ?? '/og/default.png', SITE.url).href;
const graph = [
  { '@type': 'WebSite', '@id': `${SITE.url}/#web`, url: `${SITE.url}/`, name: SITE.name, inLanguage: 'cs', publisher: { '@id': `${SITE.url}/#org` } },
  { '@type': 'Organization', '@id': `${SITE.url}/#org`, name: SITE.name, url: `${SITE.url}/`, logo: `${SITE.url}/icon-512.png`, email: SITE.email },
  ...(crumbs.length
    ? [{ '@type': 'BreadcrumbList', itemListElement: [{ name: 'Úvod', url: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.url, SITE.url).href })) }]
    : []),
  ...schema,
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const topComps = COMPETITIONS.filter((c) => c.top);
const robots = noindex || isDemo ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
const navLink = 'px-2.5 xl:px-3 py-2 rounded-[10px] no-underline font-display font-bold text-[1.02rem] min-h-[44px] inline-flex items-center whitespace-nowrap border-2';
const footLink = 'text-[#d6e4dc] hover:text-white no-underline hover:underline';
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <meta name="theme-color" content="#f6f4ee" />
  <meta name="color-scheme" content="light" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/fonts/familjen-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/atkinson-latin.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={SITE.locale} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="build" content={__BUILD_ID__} />
  <script type="speculationrules" set:html={JSON.stringify({ prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/go/*' } }, { not: { href_matches: '/api/*' } }] }, eagerness: 'moderate' }] })} />
  <script type="application/ld+json" set:html={ld} />
  <slot name="head" />
</head>
<body class="min-h-screen flex flex-col">
  <a class="sr focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 bg-ticket px-3 py-2 rounded-lg border-2 border-ink" href="#obsah">Přeskočit na obsah</a>
  {isDemo && (
    <div class="bg-warn-soft text-warn border-b-2 border-ink text-sm font-bold" role="status">
      <div class="wrap py-2 flex items-center gap-2"><Icon name="circle-alert" size={16} />Demonstrační data – smyšlené zápasy a kurzy pro vývoj webu. Nejsou to skutečné nabídky.</div>
    </div>
  )}
  <header class="sticky top-0 z-40 bg-paper/95 backdrop-blur border-b-2 border-ink" data-header>
    <div class="wrap flex items-center gap-2 sm:gap-3 min-h-[64px]">
      <a href="/" class="no-underline shrink-0 rounded-lg" aria-label={`${SITE.name} – úvod`}><Logo /></a>
      <nav class="hidden lg:flex items-center gap-1 ml-5" aria-label="Hlavní menu">
        {NAV.map((n) => {
          const on = path.startsWith(n.href);
          return <a href={n.href} aria-current={on ? 'page' : undefined}
            class:list={[navLink, on ? 'bg-ink text-white border-ink hover:text-white' : (n as { accent?: boolean }).accent ? 'bg-orange text-ink border-ink hover:bg-ticket' : 'border-transparent text-ink hover:border-ink hover:bg-ticket']}>{n.label}</a>;
        })}
      </nav>
      <div class="ml-auto flex items-center gap-0.5 sm:gap-1.5">
        <form action="/hledat/" method="get" role="search" class="relative hidden lg:block" data-search>
          <label for="q-head" class="sr">Hledat tým, soutěž nebo zápas</label>
          <Icon name="search" size={18} class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-2 pointer-events-none" />
          <input id="q-head" name="q" type="search" autocomplete="off" placeholder="Najdi tým nebo soutěž" minlength="2"
            class="field !min-h-[44px] w-[150px] xl:w-[250px] pl-10 text-[16px]" aria-controls="q-head-list" aria-expanded="false" aria-autocomplete="list" role="combobox" />
          <ul id="q-head-list" role="listbox" hidden class="absolute right-0 top-[calc(100%+8px)] w-[360px] max-h-[70vh] overflow-auto card p-1.5"></ul>
        </form>
        <a href="/hledat/" class="lg:hidden btn btn--quiet min-w-[44px]" aria-label="Hledat"><Icon name="search" size={22} /></a>
        <a href="/oblibene/" class="btn btn--quiet min-w-[44px] relative text-ink" aria-label="Moje sledované" data-fav-link>
          <Icon name="star" size={22} /><span class="hidden xl:inline font-display">Sledované</span>
          <span data-fav-count hidden class="absolute -top-0.5 -right-0.5 sm:static min-w-[22px] h-[22px] px-1 rounded-full bg-orange text-ink border-2 border-ink text-xs font-bold grid place-items-center num"></span>
        </a>
        <details class="lg:hidden relative" data-menu>
          <summary class="btn btn--ghost btn--sm !px-2.5 list-none [&::-webkit-details-marker]:hidden" aria-label="Menu"><Icon name="menu" size={20} /><span class="hidden sm:inline">Menu</span></summary>
          <nav class="absolute right-0 top-[calc(100%+10px)] w-[min(88vw,320px)] card p-2 grid" aria-label="Menu">
            {NAV.map((n) => <a class="px-4 py-3 rounded-lg no-underline text-ink font-display font-bold text-lg hover:bg-green-soft" href={n.href}>{n.label}</a>)}
            <hr class="my-1 border-line" />
            <a class="px-4 py-3 rounded-lg no-underline text-ink hover:bg-green-soft" href="/fotbal/">Fotbal</a>
            <a class="px-4 py-3 rounded-lg no-underline text-ink hover:bg-green-soft" href="/hokej/">Hokej</a>
            <a class="px-4 py-3 rounded-lg no-underline text-ink hover:bg-green-soft" href="/tenis/">Tenis</a>
            <a class="px-4 py-3 rounded-lg no-underline text-ink hover:bg-green-soft" href="/basketbal/">Basketbal</a>
            <a class="px-4 py-3 rounded-lg no-underline text-ink hover:bg-green-soft" href="/esporty/">Esporty</a>
            <a class="px-4 py-3 rounded-lg no-underline text-ink hover:bg-green-soft" href="/kalkulacky/">Kolik vyhraju? (kalkulačka)</a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  {crumbs.length > 0 && (
    <nav class="wrap pt-4 text-[0.95rem]" aria-label="Drobečková navigace">
      <ol class="flex flex-wrap items-center gap-1 text-ink-2">
        <li><a href="/" class="text-ink-2">Úvod</a></li>
        {crumbs.map((c, i) => (
          <li class="flex items-center gap-1"><Icon name="chevron-right" size={14} class="text-ink-3" />
            {i === crumbs.length - 1 ? <span aria-current="page" class="text-ink font-bold">{c.name}</span> : <a class="text-ink-2" href={c.url}>{c.name}</a>}</li>
        ))}
      </ol>
    </nav>
  )}

  <main id="obsah" class="flex-1"><slot /></main>

  <footer class="mt-20 bg-night text-[#d6e4dc] border-t-2 border-ink">
    <div class="wrap pt-12 pb-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <Logo invert />
        <p class="mt-4 max-w-[38ch]">Kurzy na fotbal, hokej, tenis, esporty a další sporty přehledně a srozumitelně. Ukážeme, kolik zápas vyplácí a jak se kurz mění. Bez registrace.</p>
      </div>
      <div><h2 class="text-white text-lg mb-3">Kurzy</h2>
        <ul class="grid gap-2">
          <li><a class={footLink} href="/kurzy/">Všechny zápasy a kurzy</a></li>
          <li><a class={footLink} href="/dnes/">Zápasy dnes</a></li>
          <li><a class={footLink} href="/radar/">Pohyby kurzů</a></li>
          <li><a class={footLink} href="/fotbal/">Fotbal</a></li>
          <li><a class={footLink} href="/hokej/">Hokej</a></li>
          <li><a class={footLink} href="/tenis/">Tenis</a></li>
          <li><a class={footLink} href="/basketbal/">Basketbal</a></li>
          <li><a class={footLink} href="/esporty/">Esporty</a></li>
          <li><a class={footLink} href="/sporty/">Všechny sporty</a></li>
          {topComps.slice(0, 4).map((c) => <li><a class={footLink} href={`/souteze/${c.slug}/`}>{c.name}</a></li>)}
          <li><a class={footLink} href="/souteze/">Všechny soutěže</a></li>
        </ul></div>
      <div><h2 class="text-white text-lg mb-3">Jak na to</h2>
        <ul class="grid gap-2">
          <li><a class={footLink} href="/pruvodce/kurzy-pro-zacatecniky/">Kurzy pro začátečníky</a></li>
          <li><a class={footLink} href="/pruvodce/">Všechny průvodce</a></li>
          <li><a class={footLink} href="/kalkulacky/">Kolik vyhraju? (kalkulačka)</a></li>
          <li><a class={footLink} href="/sazkove-kancelare/">Kde vsadit</a></li>
          <li><a class={footLink} href="/sazkove-kancelare/srovnani/">Srovnání kanceláří</a></li>
          <li><a class={footLink} href="/pojem/">Rejstřík pojmů</a></li>
          <li><a class={footLink} href="/oblibene/">Moje sledované</a></li>
        </ul></div>
      <div><h2 class="text-white text-lg mb-3">O webu</h2>
        <ul class="grid gap-2">
          <li><a class={footLink} href="/metodika/">Odkud bereme data</a></li>
          <li><a class={footLink} href="/o-nas/">O nás a kontakt</a></li>
          <li><a class={footLink} href="/financovani/">Jak se financujeme</a></li>
          <li><a class={footLink} href="/odpovedne-hrani/">Odpovědné hraní</a></li>
          <li><a class={footLink} href="/soukromi/">Ochrana soukromí</a></li>
          <li><a class={footLink} href="/cookies/">Cookies</a></li>
        </ul></div>
    </div>
    <div class="wrap pb-10">
      <div class="flex gap-4 items-start rounded-[14px] border-2 border-[#d6e4dc] p-4">
        <span class="shrink-0 grid place-items-center w-12 h-12 rounded-full bg-orange text-ink border-2 border-ink font-display font-bold">18+</span>
        <p class="m-0">Sázení je jen pro dospělé a může způsobit závislost. Kurz není předpověď a žádná sázka není jistá. Uvádíme jen kanceláře, které mají podle dostupných údajů povolení Ministerstva financí ČR. Potřebuješ pomoc? {HELP.naberteKurz.name} <a class="text-white" href={`tel:${HELP.naberteKurz.tel}`}>{HELP.naberteKurz.phone}</a> ({HELP.naberteKurz.note}), {HELP.linka.name} <a class="text-white" href={`tel:${HELP.linka.tel}`}>{HELP.linka.phone}</a> ({HELP.linka.note}).</p>
      </div>
      <p class="mt-5 text-[0.95rem] max-w-[95ch]">Odkazy na {PARTNERS.map((b) => b.name).join(', ').replace(/, ([^,]*)$/, ' a $1')} jsou partnerské: když se přes ně někdo zaregistruje, můžeme dostat provizi. Na to, který kurz ukážeme jako nejvyšší, to vliv nemá. <a class="text-white" href="/financovani/">Jak se financujeme</a>.</p>
      <p class="mt-3 text-[0.95rem]">Provozovatel: {SITE.operator.name}, IČO {SITE.operator.ico}, {SITE.operator.vat} · <a class="text-white" href={`mailto:${SITE.email}`}>{SITE.email}</a> · © 2026 {SITE.name}</p>
    </div>
  </footer>
  <script src="../scripts/site.ts"></script>
</body>
</html>
