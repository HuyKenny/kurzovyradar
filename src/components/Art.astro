---
// Sticker-style illustrations (public/img/art/, generated by scripts/art.mjs, listed in src/data/art.json).
// Control icons stay Lucide (Icon.astro). A name that is not in the manifest renders nothing.
import manifest from '../data/art.json';
interface Props { name: string; size?: number; class?: string; alt?: string; eager?: boolean }
const { name, size = 40, class: cls = '', alt = '', eager = false } = Astro.props;
const m = (manifest as Record<string, { w: number; h: number; file: string }>)[name];
const h = m ? Math.round((size * m.h) / m.w) : 0;
---
{m && <img src={`/img/art/${m.file}`} width={size} height={h} alt={alt} aria-hidden={alt ? undefined : 'true'} loading={eager ? 'eager' : 'lazy'} decoding="async" class={`shrink-0 ${cls}`} />}
