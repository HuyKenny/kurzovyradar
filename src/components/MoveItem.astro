---
// One recorded movement told as a sentence: who, which bookmaker, from → to, since when, and a tiny chart.
// Direction is an arrow + word + signed number; colour only repeats it.
import { odds as fmt, pct, dateTime, kickoff, ago } from '../lib/format';
import type { FeedBook } from '../config/bookmakers';
import type { MoveItem } from '../server/view';
import { atBooks } from '../lib/ticket';
import { betUrl } from '../lib/links';
import { betTarget } from '../lib/market';
import Icon from './Icon.astro';
import Sparkline from './Sparkline.astro';
interface Props { m: MoveItem & { books?: FeedBook[] }; now: number; windowLabel: string; compact?: boolean; back?: string }
const { m, now, windowLabel, compact = false, back } = Astro.props;
const href = betUrl(m.url, m.outcome, back);
const down = m.to.odds < m.from.odds;
const books = m.books ?? [m.book];
const target = betTarget(m.sport, m.outcome, m.home, m.away);
const why = m.reason === 'high'
  ? `Je to nejvyšší kurz, jaký jsme ${windowLabel} zapsali.`
  : down ? 'Kancelář teď za tenhle výsledek vyplácí méně než dřív.' : 'Kancelář teď za tenhle výsledek vyplácí víc než dřív.';
---
<li class="ticket p-4 flex flex-col gap-2">
  <p class="m-0 text-[0.95rem] text-ink-2 flex flex-wrap gap-x-2"><span class="font-bold text-ink num">{kickoff(m.startAt, now)}</span><span>{m.compName}</span></p>
  <h3 class="m-0 text-[1.15rem]"><a href={href} class="text-ink no-underline hover:underline">{m.home} vs {m.away}</a></h3>
  <p class="m-0 text-[1.05rem]">
    Kurz na <strong>{target}</strong> {down ? 'klesl' : 'stoupl'} z <span class="num">{fmt(m.from.odds)}</span> na <strong class="num">{fmt(m.to.odds)}</strong> {atBooks(books)}.
  </p>
  <div class="flex items-center gap-3 flex-wrap">
    <span class:list={['badge num', down ? 'badge--orange' : 'badge--green']}><Icon name={down ? 'trending-down' : 'trending-up'} size={15} />{down ? 'klesl' : 'stoupl'} o {pct(Math.abs(m.pct), false)}</span>
    <span class="text-[0.9rem] text-ink-2">změna {ago(m.to.at, now)}</span>
    <span class="ml-auto"><Sparkline points={m.points} to={now} label={`Zapsaný vývoj kurzu od ${fmt(m.from.odds)} do ${fmt(m.to.odds)}`} /></span>
  </div>
  {!compact && <p class="m-0 text-[0.92rem] text-ink-2">{why} Porovnáváme zápis z <time class="num" datetime={new Date(m.from.at * 1000).toISOString()}>{dateTime(m.from.at)}</time> s posledním z <time class="num" datetime={new Date(m.to.at * 1000).toISOString()}>{dateTime(m.to.at)}</time>.</p>}
  {compact && <p class="m-0 text-[0.9rem] text-ink-2">{why}</p>}
  <a href={href} class="font-bold inline-flex items-center gap-1 min-h-[40px]">Prohlédnout sázku <span aria-hidden="true">→</span></a>
</li>
