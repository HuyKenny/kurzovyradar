---
// Logo: ticket-shaped symbol with a radar sweep (public/img/art/logo-symbol.svg, scripts/art.mjs) + wordmark.
interface Props { size?: 'md' | 'lg'; invert?: boolean }
const { size = 'md', invert = false } = Astro.props;
const px = size === 'lg' ? 46 : 38;
---
<span class="inline-flex items-center gap-2 select-none">
  <img src="/img/art/logo-symbol.svg" width={px} height={px} alt="" aria-hidden="true" class="-rotate-6" />
  <span class:list={['font-display font-bold tracking-[-0.03em] leading-none', size === 'lg' ? 'text-[1.75rem]' : 'text-[1.25rem] sm:text-[1.4rem]', invert ? 'text-white' : 'text-ink']}>
    Kurzový<span class={invert ? 'text-orange' : 'text-green'}>Radar</span>
  </span>
</span>
