---
/**
 * Recorded odds of one outcome over time, server-rendered SVG (no chart library, works without JS).
 * Step line: a price holds until the next recorded change. Bookmakers differ by colour AND by line style + marker
 * shape (Tipsport solid/circle, Chance dashed/square), with a legend. Gaps = failed import runs, drawn as shaded bands
 * and named in the text. Only stored values are drawn; nothing is interpolated or invented.
 */
import { BOOK, type FeedBook } from '../config/bookmakers';
import { odds as fmt, dateTime, time, dateShort } from '../lib/format';

export interface Series { book: FeedBook; points: { at: number; odds: number; enabled: boolean }[] }
interface Props { series: Series[]; from: number; to: number; gaps?: { from: number; to: number }[]; label: string; id: string; w?: number; h?: number }
// Draw at the size it is shown (mobile and desktop variants), so axis text stays ~13 px instead of scaling with the viewBox.
const { series, from, to, gaps = [], label, id, w = 680, h = 280 } = Astro.props;

const STYLE: Record<FeedBook, { color: string; dash?: string; marker: 'circle' | 'square' }> = {
  tipsport: { color: '#1f6fe0', marker: 'circle' },
  chance: { color: '#0e6b47', dash: '6 4', marker: 'square' },
};
const W = w, H = h, L = 46, R = 10, T = 12, B = 28;
const vals = series.flatMap((s) => s.points.map((p) => p.odds));
const lo = Math.min(...vals), hi = Math.max(...vals);
// Clean y range around the data (odds steps of 0.05 / 0.1 / 0.25 …)
const span = Math.max(hi - lo, 50);
const steps = [10, 20, 50, 100, 250, 500, 1000, 2000, 5000];
const step = steps.find((s) => span / s <= 5) ?? 10000;
const y0 = Math.floor((lo - step * 0.5) / step) * step, y1 = Math.ceil((hi + step * 0.5) / step) * step;
const x = (t: number) => L + ((t - from) / Math.max(1, to - from)) * (W - L - R);
const y = (v: number) => T + (1 - (v - y0) / Math.max(1, y1 - y0)) * (H - T - B);
const yTicks: number[] = [];
for (let v = y0; v <= y1 + 1e-6; v += step) yTicks.push(v);
// x ticks: 4–6 round hours or days
const spanS = to - from;
const xStep = [3600, 3 * 3600, 6 * 3600, 12 * 3600, 86400, 2 * 86400].find((s) => spanS / s <= 6) ?? 4 * 86400;
const xTicks: number[] = [];
for (let t = Math.ceil(from / xStep) * xStep; t <= to; t += xStep) xTicks.push(t);
const xLabel = (t: number) => (xStep >= 86400 ? dateShort(t) : time(t) === '00:00' ? dateShort(t) : time(t));

function path(s: Series): string {
  const pts = s.points.filter((p) => p.at <= to);
  const before = [...pts].reverse().find((p) => p.at <= from);
  const inside = pts.filter((p) => p.at > from);
  const seq = before ? [{ ...before, at: from }, ...inside] : inside;
  if (!seq.length) return '';
  let d = `M${x(seq[0]!.at).toFixed(1)},${y(seq[0]!.odds).toFixed(1)}`;
  for (let i = 1; i < seq.length; i++) d += `H${x(seq[i]!.at).toFixed(1)}V${y(seq[i]!.odds).toFixed(1)}`;
  return d + `H${x(to).toFixed(1)}`;
}
const marks = (s: Series) => s.points.filter((p) => p.at > from && p.at <= to);
const sig = (s: Series) => s.points.map((p) => `${p.odds}:${p.enabled}`).join(',');
const overlap = series.length > 1 && series.every((s) => sig(s) === sig(series[0]!));
---
<figure class="m-0" data-chart>
  <div class="relative">
    <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto block" role="img" aria-labelledby={`${id}-t`}>
      <title id={`${id}-t`}>{label}. Podrobné hodnoty jsou v tabulce pod grafem.</title>
      {gaps.map((g) => <rect x={x(Math.max(g.from, from))} y={T} width={Math.max(2, x(Math.min(g.to, to)) - x(Math.max(g.from, from)))} height={H - T - B} fill="#eeebe2" />)}
      {yTicks.map((v) => (
        <g>
          <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="#e4dfd2" stroke-width="1" />
          <text x={L - 8} y={y(v) + 4} text-anchor="end" font-size="13" fill="#4a554f" class="num">{fmt(v)}</text>
        </g>
      ))}
      {xTicks.map((t) => <text x={x(t)} y={H - 10} text-anchor="middle" font-size="13" fill="#4a554f">{xLabel(t)}</text>)}
      {series.map((s) => (
        <path d={path(s)} fill="none" stroke={STYLE[s.book].color} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray={STYLE[s.book].dash} />
      ))}
      {series.map((s) => marks(s).map((p) => {
        const st = STYLE[s.book];
        const tip = `${BOOK[s.book].name}: ${fmt(p.odds)} · ${dateTime(p.at)}${p.enabled ? '' : ' · pozastaveno'}`;
        return (
          <g data-p={tip} tabindex="0" role="img" aria-label={tip} class="outline-none focus-visible:[&>*:first-child]:fill-[#ffe7d6]">
            <circle cx={x(p.at)} cy={y(p.odds)} r="11" fill="transparent" />
            {st.marker === 'circle'
              ? <circle cx={x(p.at)} cy={y(p.odds)} r="4.5" fill={st.color} stroke="#fff" stroke-width="2" />
              : <rect x={x(p.at) - 4.5} y={y(p.odds) - 4.5} width="9" height="9" fill={st.color} stroke="#fff" stroke-width="2" />}
          </g>
        );
      }))}
    </svg>
    <div data-tip hidden role="status" class="pointer-events-none absolute -translate-x-1/2 -translate-y-full bg-ink text-white text-xs font-semibold rounded-md px-2 py-1 whitespace-nowrap num"></div>
  </div>
  <figcaption class="flex flex-wrap gap-x-5 gap-y-1 mt-2 text-sm text-ink-2">
    {series.map((s) => (
      <span class="inline-flex items-center gap-1.5">
        <svg width="26" height="10" aria-hidden="true"><line x1="1" x2="25" y1="5" y2="5" stroke={STYLE[s.book].color} stroke-width="2" stroke-dasharray={STYLE[s.book].dash} />
          {STYLE[s.book].marker === 'circle' ? <circle cx="13" cy="5" r="3.5" fill={STYLE[s.book].color} /> : <rect x="9.5" y="1.5" width="7" height="7" fill={STYLE[s.book].color} />}</svg>
        {BOOK[s.book].name} <span class="sr">({STYLE[s.book].marker === 'circle' ? 'plná čára, kruhy' : 'čárkovaná čára, čtverce'})</span>
      </span>
    ))}
    {gaps.length > 0 && <span class="inline-flex items-center gap-1.5"><span class="inline-block w-4 h-3 bg-[#eeebe2] border border-line" aria-hidden="true"></span>výpadek dat</span>}
    {overlap && <span class="basis-full">Čáry se překrývají: obě kanceláře měly stejné kurzy.</span>}
  </figcaption>
</figure>
