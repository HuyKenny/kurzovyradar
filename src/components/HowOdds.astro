---
// "Kurz za 30 vteřin": the one idea a newcomer needs, with a tiny calculator (server result for 100 Kč, live with JS).
import Art from './Art.astro';
interface Props { odds?: number; who?: string }
const { odds = 1.85, who = 'domácí' } = Astro.props;
const f = (n: number) => n.toFixed(2).replace('.', ',');
---
<div class="card p-5 md:p-7 grid gap-6 md:grid-cols-[1.1fr_1fr] md:items-center" data-mini-calc>
  <div>
    <p class="eyebrow m-0 flex items-center gap-2"><Art name="kalkulacka" size={26} />Poprvé tady?</p>
    <h2 class="mt-2 mb-3">Kurz za 30 vteřin</h2>
    <p class="m-0 text-[1.08rem]">Kurz říká, kolikrát se ti vsazené peníze vrátí, když tip vyjde. <strong>Vsadíš 100 Kč na kurz {f(odds)} a vyhraješ? Dostaneš {Math.round(100 * odds)} Kč</strong>, z toho {Math.round(100 * odds) - 100} Kč je čistý zisk.</p>
    <p class="mt-3 mb-0 text-ink-2">Čím vyšší kurz, tím víc vyplatí, ale tím méně kancelář věří, že to vyjde.</p>
    <a href="/pruvodce/kurzy-pro-zacatecniky/" class="btn btn--ghost mt-5">Kurzy pro začátečníky</a>
  </div>
  <form class="bg-green-soft border-2 border-ink rounded-[14px] p-4 grid gap-3" action="/kalkulacky/" method="get">
    <p class="hand m-0 text-[1.45rem]">Zkus si to ↓</p>
    <div class="grid grid-cols-2 gap-3">
      <label class="grid gap-1 font-bold text-[0.95rem]">Vsadím (Kč)<input class="field num" name="vklad" inputmode="decimal" value="100" data-in="stake" /></label>
      <label class="grid gap-1 font-bold text-[0.95rem]">Kurz<input class="field num" name="kurz" inputmode="decimal" value={f(odds)} data-in="odds" /></label>
    </div>
    <output class="block text-[1.1rem]" aria-live="polite" data-out>Když tip vyjde, dostaneš <strong class="num">{Math.round(100 * odds)} Kč</strong> (zisk {Math.round(100 * odds) - 100} Kč).</output>
    <button class="btn btn--sm justify-self-start" type="submit" data-nojs>Spočítat</button>
  </form>
</div>
