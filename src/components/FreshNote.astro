---
// "When did we last check" line, shown above every odds list. Failing or stale books are named.
import { BOOK, FEED_BOOKS } from '../config/bookmakers';
import { isFresh } from '../server/store/derive';
import { time, dateTime } from '../lib/format';
import type { UpcomingSnapshot } from '../server/view';
import type { Settings } from '../server/types';
import Icon from './Icon.astro';
interface Props { books: UpcomingSnapshot['books']; now: number; cfg: Settings }
const { books, now, cfg } = Astro.props;
const stale = FEED_BOOKS.filter((b) => !isFresh(books[b], now, cfg));
const ok = FEED_BOOKS.filter((b) => isFresh(books[b], now, cfg));
---
<p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-2 m-0">
  <Icon name="clock" size={15} class="text-ink-3" />
  {ok.length > 0 && <span>Kurzy {ok.map((b) => `${BOOK[b].name} ${time(books[b]!.lastSuccessAt!)}`).join(', ')} · kontrolujeme každých {cfg.importIntervalMin} min</span>}
  {stale.map((b) => (
    <span class="badge badge--warn">{books[b]?.lastSuccessAt ? `${BOOK[b].name}: poslední známé údaje z ${dateTime(books[b]!.lastSuccessAt!)}, do srovnání je nezapočítáváme` : `${BOOK[b].name}: kurzy zatím nejsou k dispozici`}</span>
  ))}
</p>
