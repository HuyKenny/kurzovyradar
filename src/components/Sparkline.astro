---
// Tiny step line of recorded values (single series: no legend; the sentence beside it carries the meaning).
interface Props { points: [number, number][]; to: number; label: string }
const { points, to, label } = Astro.props;
const W = 112, H = 34, P = 4;
const vs = points.map((p) => p[1]);
const lo = Math.min(...vs), hi = Math.max(...vs);
const t0 = points[0]![0];
const x = (t: number) => P + ((t - t0) / Math.max(1, to - t0)) * (W - 2 * P);
const y = (v: number) => (hi === lo ? H / 2 : P + (1 - (v - lo) / (hi - lo)) * (H - 2 * P));
let d = `M${x(points[0]![0]).toFixed(1)},${y(points[0]![1]).toFixed(1)}`;
for (const [t, v] of points.slice(1)) d += `H${x(t).toFixed(1)}V${y(v).toFixed(1)}`;
d += `H${x(to).toFixed(1)}`;
const last = points[points.length - 1]!;
---
<svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} class="shrink-0">
  <path d={d} fill="none" stroke="#46546d" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
  <circle cx={x(to)} cy={y(last[1])} r="4" fill="#112039" stroke="#fff" stroke-width="2" />
</svg>
