---
import Base from '../../layouts/Base.astro';
import Ticket from '../../components/Ticket.astro';
import OddsChart, { type Series } from '../../components/OddsChart.astro';
import BookLogo from '../../components/BookLogo.astro';
import FavButton from '../../components/FavButton.astro';
import CanvaIcon from '../../components/CanvaIcon.astro';
import { BOOK, FEED_BOOKS, type FeedBook } from '../../config/bookmakers';
import { SPORTS, competitionBySlug } from '../../config/competitions';
import { E, upcoming, eventDetail, listable, cfg as getCfg, now as getNow, cacheHeader } from '../../lib/data';
import { ticketView, atBooks, STATE_TEXT, OUTCOMES, whoOf } from '../../lib/ticket';
import { odds as fmt, pct, dateTime, date, time, kickoff, ago, kc } from '../../lib/format';
import { changePct, overround, implied } from '../../server/calc/odds';
import type { Outcome } from '../../server/types';

const m = /^(.*)-(\d+)$/.exec(Astro.params.slug ?? '');
if (!m) return Astro.rewrite('/404/');
const id = Number(m[2]);
const d = await eventDetail(id);
if (!d) return Astro.rewrite('/404/');
const { ev, history } = d;
if (Astro.url.pathname !== ev.url) return Astro.redirect(ev.url, 301);
const t = getNow();
const cfg = getCfg();
if (ev.startAt < t - 7 * 86400) return new Response('Zápas skončil a jeho kurzy už nezobrazujeme.', { status: 410, headers: { 'content-type': 'text/plain; charset=utf-8' } });
const up = await upcoming();
const books = up.books;
const started = ev.startAt <= t;
const v = ticketView(ev, books, t, cfg);
const comp = competitionBySlug(ev.comp);
const comparable = FEED_BOOKS.filter((b) => ev.books[b] && !ev.books[b]!.mismatch);
const offer = (b: FeedBook, o: Outcome) => ev.books[b]?.outcomes[o];

// "Kolik vyhraju?" — computed on the server from ?vklad & ?tip (works without JS), live in the browser.
const q = Astro.url.searchParams;
const stake = Math.min(1e7, Math.max(0, Number((q.get('vklad') ?? '100').replace(',', '.')) || 100));
const pick = (OUTCOMES as string[]).includes(q.get('tip') ?? '') ? (q.get('tip') as Outcome) : (v.favourite?.outcome ?? '1');
const pickOdds = v.outcomes.find((o) => o.outcome === pick)?.best?.odds ?? null;

// Tracking window and data gaps (failed import runs).
const firstAt = history.length ? Math.min(...history.map((h) => h.at)) : null;
const endAt = Math.min(t, ev.startAt);
const gaps: { from: number; to: number }[] = [];
if (firstAt) {
  const runs = await E.DB.prepare("SELECT book, started_at FROM import_runs WHERE status = 'error' AND started_at BETWEEN ? AND ? ORDER BY started_at")
    .bind(firstAt, endAt).all<{ book: string; started_at: number }>();
  const step = cfg.importIntervalMin * 60;
  for (const r of runs.results) {
    const last = gaps[gaps.length - 1];
    if (last && r.started_at - last.to <= step) last.to = r.started_at + step;
    else gaps.push({ from: r.started_at, to: r.started_at + step });
  }
}
const span = firstAt ? endAt - firstAt : 0;
const periods = [
  ...[{ key: '24h', label: '24 hodin', s: 86400 }, { key: '3d', label: '3 dny', s: 3 * 86400 }].filter((p) => span > p.s * 1.1),
  { key: 'vse', label: 'Celé sledování', s: span },
];
const series = (o: Outcome): Series[] => comparable.map((b) => ({ book: b, points: history.filter((h) => h.book === b && h.outcome === o) })).filter((s) => s.points.length);
const enough = history.length > 0;

// What happened, in sentences. Identical books are told once.
const story: string[] = [];
for (const o of OUTCOMES) {
  const who = o === 'x' ? 'remízu' : whoOf(ev, o);
  const parts = comparable.map((b) => ({ b, x: offer(b, o) })).filter((p) => p.x);
  if (!parts.length) continue;
  const sameAll = parts.every((p) => p.x!.odds === parts[0]!.x!.odds && p.x!.firstOdds === parts[0]!.x!.firstOdds);
  const groups = sameAll ? [{ books: parts.map((p) => p.b), x: parts[0]!.x! }] : parts.map((p) => ({ books: [p.b], x: p.x! }));
  for (const g of groups) {
    const where = atBooks(g.books);
    if (g.x.odds === g.x.firstOdds) story.push(`Kurz na ${who} se ${where} od začátku sledování nezměnil (${fmt(g.x.odds)}).`);
    else story.push(`Kurz na ${who} ${where} ${g.x.odds < g.x.firstOdds ? 'klesl' : 'stoupl'} z ${fmt(g.x.firstOdds)} na ${fmt(g.x.odds)} (${pct(changePct(g.x.firstOdds, g.x.odds))}).`);
  }
}
const margins = comparable.map((b) => ({ b, v: overround(Object.fromEntries(OUTCOMES.map((o) => [o, offer(b, o)?.odds ? offer(b, o)!.odds / 1000 : undefined])), OUTCOMES) }))
  .filter((x) => x.v !== null);
const related = listable(up, t, cfg).filter((e) => e.comp === ev.comp && e.id !== ev.id).slice(0, 4);
const S = SPORTS[ev.sport];
const minutes = ev.sport === 'hokej' ? '60 minutách' : '90 minutách a nastavení';
const title = `${ev.home} – ${ev.away}: kurzy a jejich vývoj (${date(ev.startAt)}) | KurzovýRadar`;
const desc = `Kurzy na zápas ${ev.home} – ${ev.away} (${ev.compName}, ${date(ev.startAt)} ${time(ev.startAt)}): kolik vyplatí Tipsport a Chance a jak se kurz měnil.`;
const schema = [{
  '@type': 'SportsEvent', name: `${ev.home} – ${ev.away}`, startDate: new Date(ev.startAt * 1000).toISOString(), sport: S.name,
  eventStatus: 'https://schema.org/EventScheduled',
  homeTeam: { '@type': 'SportsTeam', name: ev.home }, awayTeam: { '@type': 'SportsTeam', name: ev.away },
  superEvent: { '@type': 'SportsEvent', name: ev.compName },
}];
const oddsData = JSON.stringify(Object.fromEntries(v.outcomes.map((o) => [o.outcome, o.best?.odds ?? 0])));
const offState = (o: (typeof v.outcomes)[number]) => STATE_TEXT[o.cells.find((c) => c.state !== 'missing')?.state ?? 'missing'];
const lastKnown = (o: Outcome) => comparable.map((b) => offer(b, o)).find(Boolean);
Astro.response.headers.set('Cache-Control', cacheHeader());
---
<Base title={title} description={desc} schema={schema} noindex={!enough || q.size > 0} canonical={ev.url}
  crumbs={[{ name: S.name, url: S.path }, { name: ev.compName, url: `/souteze/${ev.comp}/` }, { name: `${ev.home} – ${ev.away}`, url: ev.url }]}>
  <div class="wrap pt-6">
    <article class="ticket">
      <div class="ticket__stub" style={`background:${comp?.color ?? '#e9e6dc'}`}>
        <CanvaIcon name={ev.sport} size={22} />
        <a href={`/souteze/${ev.comp}/`} class="text-ink no-underline hover:underline">{ev.compName}</a>
        <time class="ml-auto num normal-case tracking-normal text-base" datetime={new Date(ev.startAt * 1000).toISOString()}>{kickoff(ev.startAt, t)}</time>
      </div>
      <div class="p-5 md:p-7 grid gap-6 lg:grid-cols-[minmax(0,1fr)_380px]">
        <div class="min-w-0">
          <h1 class="m-0 text-balance">{ev.home} <span class="text-ink-3 font-normal">vs</span> {ev.away}</h1>
          <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-ink-2">
            {firstAt && <span>Kurzy sledujeme od {dateTime(firstAt)}</span>}
            <FavButton ev={ev} big />
          </div>
          {started && <p class="note-box mt-4 mb-0">Zápas už začal. Ukazujeme poslední kurzy před výkopem. Kurzy během zápasu nesledujeme.</p>}
          <h2 class="text-[1.25rem] mt-6 mb-3">Kolik kdo vyplácí</h2>
          {v.books.length === 0 && !started ? <p class="m-0">Kurzy teď nejsou v nabídce. Zkontrolujeme je znovu za pár minut.</p> : (
            <ul class="grid grid-cols-3 gap-2 sm:gap-3 list-none p-0 m-0">
              {v.outcomes.map((o) => (
                <li class="min-w-0">
                  {o.best ? (
                    <a href={`/go/${o.best.books[0]}/?e=${ev.id}&p=detail`} rel="sponsored nofollow" class:list={['odd !min-h-[72px]', !o.same && v.books.length > 1 && 'odd--best']}
                      aria-label={`${o.who}: kurz ${fmt(o.best.odds)} ${atBooks(o.best.books)}`}>
                      <span class="odd__who">{o.who}</span><span class="odd__val !text-[1.6rem]">{fmt(o.best.odds)}</span>
                      {!o.same && v.books.length > 1 && <span class="text-[0.8rem] font-bold text-green-ink">víc {BOOK[o.best.books[0]!].locative}</span>}
                    </a>
                  ) : (
                    <span class="odd odd--off !min-h-[72px]"><span class="odd__who">{o.who}</span><span class="odd__val">{lastKnown(o.outcome) ? fmt(lastKnown(o.outcome)!.odds) : '–'}</span><span class="text-[0.8rem]">{offState(o)}</span></span>
                  )}
                </li>
              ))}
            </ul>
          )}
          {v.allSame && <p class="mt-3 mb-0 flex flex-wrap items-center gap-2 text-ink-2"><span class="inline-flex gap-1">{v.books.map((b) => <BookLogo id={b} h={20} />)}</span>Stejné kurzy {atBooks(v.books)}. Je jedno, kde vsadíš.</p>}
          {v.books.length > 1 && !v.allSame && (
            <table class="w-full mt-3 text-[1rem]">
              <caption class="sr">Kurzy podle kanceláří</caption>
              <thead><tr class="text-ink-2 text-[0.9rem]"><th scope="col" class="text-left font-normal pb-1">Kancelář</th>{v.outcomes.map((o) => <th scope="col" class="font-normal pb-1 truncate max-w-[8ch]">{o.who}</th>)}</tr></thead>
              <tbody>{v.books.map((b) => (
                <tr class="border-t border-line"><th scope="row" class="text-left py-1.5 font-normal"><BookLogo id={b} h={20} /></th>
                  {v.outcomes.map((o) => { const c = o.cells.find((x) => x.book === b)!; return <td class:list={['num text-center', o.best && c.current && c.odds === o.best.odds ? 'font-bold' : 'text-ink-2']}>{c.current && c.odds ? fmt(c.odds) : '–'}</td>; })}</tr>
              ))}</tbody>
            </table>
          )}
          <p class="mt-4 mb-0 text-[0.95rem] text-ink-2">Kurzy platí na výsledek po {minutes}. Prodloužení ani nájezdy se nepočítají. {v.checkedAt && <>Zkontrolováno v {time(v.checkedAt)}.</>}</p>
          {!started && comparable.some((b) => BOOK[b].affiliate === 'approved') && (
            <div class="flex flex-wrap gap-2 mt-5">
              {comparable.filter((b) => BOOK[b].affiliate === 'approved').map((b) => <a class="btn btn--ghost" href={`/go/${b}/?e=${ev.id}&p=detail`} rel="sponsored nofollow"><BookLogo id={b} h={20} />Vsadit {BOOK[b].locative}</a>)}
            </div>
          )}
        </div>

        <form id="kalkulacka" method="get" action={`${ev.url}#kalkulacka`} class="bg-green-soft border-2 border-ink rounded-[14px] p-4 self-start grid gap-3" data-win data-odds={oddsData}>
          <h2 class="text-[1.25rem] m-0 flex items-center gap-2"><CanvaIcon name="kalkulacka" size={28} />Kolik vyhraju?</h2>
          <label class="grid gap-1 font-bold text-[0.95rem]">Vsadím (Kč)<input class="field num" name="vklad" inputmode="decimal" value={String(stake)} /></label>
          <fieldset class="m-0 p-0 border-0">
            <legend class="font-bold text-[0.95rem] mb-1">Na co</legend>
            <div class="seg">
              {v.outcomes.map((o) => <label><input type="radio" name="tip" value={o.outcome} checked={o.outcome === pick} disabled={!o.best} /><span class="truncate max-w-[12ch]">{o.who}</span></label>)}
            </div>
          </fieldset>
          <output class="block text-[1.1rem]" aria-live="polite" data-out>
            {pickOdds ? <>Když to vyjde, dostaneš <strong class="num">{kc(stake * pickOdds / 1000)}</strong>, z toho zisk <strong class="num">{kc(stake * pickOdds / 1000 - stake)}</strong>.</> : 'Na tenhle výsledek teď kurz nemáme.'}
          </output>
          <button class="btn btn--sm justify-self-start" type="submit" data-nojs>Spočítat</button>
          <p class="m-0 text-[0.85rem] text-ink-2">Počítáme s nejvyšším aktuálním kurzem. Daně a podmínky kanceláře nezahrnujeme.</p>
        </form>
      </div>
    </article>

    {enough && (
      <section class="mt-12" aria-labelledby="h-story">
        <h2 id="h-story" class="flex items-center gap-2"><CanvaIcon name="radar" size={34} />Co se s kurzy dělo</h2>
        <ul class="mt-3 grid gap-2 text-[1.08rem] max-w-[75ch] list-none p-0">
          {story.map((s) => <li class="flex gap-2"><span class="hand text-[1.3rem] leading-none" aria-hidden="true">→</span><span>{s}</span></li>)}
        </ul>
      </section>
    )}

    <section class="mt-12" aria-labelledby="h-hist">
      <h2 id="h-hist" class="m-0">Vývoj kurzu v grafu</h2>
      {!enough ? <p class="card p-5 mt-4">Pro tenhle zápas zatím nemáme dost zápisů.</p> : (
        <div class="charts mt-4 card p-4 md:p-6">
          <div class="flex flex-wrap gap-3 justify-between">
            <div class="seg" role="radiogroup" aria-label="Výsledek">
              {OUTCOMES.map((o) => <label><input type="radio" name="vo" value={o} checked={o === pick} /><span>{whoOf(ev, o)}</span></label>)}
            </div>
            <div class="seg" role="radiogroup" aria-label="Období">
              {periods.map((p, i) => <label><input type="radio" name="vp" value={p.key} checked={i === periods.length - 1} /><span>{p.label}</span></label>)}
            </div>
          </div>
          {OUTCOMES.flatMap((o) => periods.map((p) => (
            <div class="chart-panel mt-4" data-k={`${o}-${p.key}`}>
              {series(o).length ? <>
                <div class="sm:hidden"><OddsChart id={`chm-${o}-${p.key}`} w={340} h={230} series={series(o)} from={Math.max(firstAt!, endAt - p.s)} to={endAt} gaps={gaps}
                  label={`Vývoj kurzu na ${o === 'x' ? 'remízu' : whoOf(ev, o)} (${p.label})`} /></div>
                <div class="hidden sm:block max-w-[820px]"><OddsChart id={`ch-${o}-${p.key}`} w={780} h={300} series={series(o)} from={Math.max(firstAt!, endAt - p.s)} to={endAt} gaps={gaps}
                  label={`Vývoj kurzu na ${o === 'x' ? 'remízu' : whoOf(ev, o)} (${p.label})`} /></div>
              </> : <p>Na tenhle výsledek nemáme zápisy.</p>}
            </div>
          )))}
          <p class="mt-3 mb-0 text-ink-2">Čára ukazuje jen kurzy, které jsme opravdu zapsali. Kurz platí, dokud ho kancelář nezmění. {gaps.length ? `Šedé pásy jsou chvíle, kdy se nám data nepodařilo načíst (${gaps.length}×).` : ''}</p>
        </div>
      )}
    </section>

    {enough && (
      <details class="mt-10 card card--flat">
        <summary class="px-5 min-h-[56px] flex items-center font-display font-bold text-lg">Pro detailisty: marže, minimum a maximum, všechny zápisy</summary>
        <div class="px-5 pb-5 grid gap-6">
          <ul class="m-0 grid gap-1.5 pl-5 list-disc">
            {v.outcomes.filter((o) => o.best).map((o) => <li>Kurz {fmt(o.best!.odds)} na „{o.who}“ odpovídá zhruba {Math.round(implied(o.best!.odds / 1000) * 100)} % šanci. Je to jen kurz převedený na procenta včetně marže kanceláře, ne skutečná pravděpodobnost.</li>)}
            {margins.map((x) => <li>Marže {BOOK[x.b].locative} na tomto zápase je {pct(x.v! * 100, false)} (součet převrácených kurzů 1, X a 2 minus 100 %).</li>)}
          </ul>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[560px] text-[0.97rem]">
              <thead><tr class="text-ink-2 text-[0.9rem] border-b-2 border-ink">
                <th scope="col" class="text-left py-2">Výsledek</th><th scope="col" class="text-left py-2">Kancelář</th>
                <th scope="col" class="text-right py-2">První zápis</th><th scope="col" class="text-right py-2">Teď</th>
                <th scope="col" class="text-right py-2">Nejníž</th><th scope="col" class="text-right py-2">Nejvýš</th>
              </tr></thead>
              <tbody>
                {OUTCOMES.flatMap((o) => comparable.map((b) => {
                  const x = offer(b, o);
                  if (!x) return null;
                  return (
                    <tr class="border-b border-line">
                      <th scope="row" class="text-left py-2 font-normal">{whoOf(ev, o)}</th><td>{BOOK[b].name}</td>
                      <td class="text-right num">{fmt(x.firstOdds)} <span class="text-ink-2 text-[0.85rem]">{dateTime(x.firstAt)}</span></td>
                      <td class="text-right num font-bold">{fmt(x.odds)}</td>
                      <td class="text-right num">{fmt(x.minOdds)}</td><td class="text-right num">{fmt(x.maxOdds)}</td>
                    </tr>
                  );
                }))}
              </tbody>
            </table>
          </div>
          <details>
            <summary class="font-bold min-h-[44px] flex items-center">Všechny zápisy ({history.length})</summary>
            <div class="overflow-x-auto">
              <table class="w-full text-[0.92rem] min-w-[480px]">
                <thead><tr class="text-ink-2 border-b border-line"><th scope="col" class="text-left py-2">Čas zápisu</th><th scope="col" class="text-left py-2">Kancelář</th><th scope="col" class="text-left py-2">Výsledek</th><th scope="col" class="text-right py-2">Kurz</th><th scope="col" class="text-left py-2 pl-3">Stav</th></tr></thead>
                <tbody>{history.map((h) => <tr class="border-b border-line"><td class="py-1.5 num">{dateTime(h.at)}</td><td>{BOOK[h.book].name}</td><td>{whoOf(ev, h.outcome)}</td><td class="text-right num">{fmt(h.odds)}</td><td class="pl-3">{h.enabled ? 'v nabídce' : 'pozastaveno'}</td></tr>)}</tbody>
              </table>
            </div>
          </details>
        </div>
      </details>
    )}

    {related.length > 0 && (
      <section class="mt-14" aria-labelledby="h-rel">
        <h2 id="h-rel" class="mb-5">Další zápasy – {ev.compName}</h2>
        <div class="grid gap-5 lg:grid-cols-2">{related.map((r) => <Ticket ev={r} books={books} now={t} cfg={cfg} place="related" showComp={false} />)}</div>
      </section>
    )}

    <aside class="mt-12 max-w-[80ch] text-ink-2">
      <p class="m-0">Kurzy kontrolujeme každých {cfg.importIntervalMin} minut a zapisujeme každou změnu. Data jsme naposledy obnovili {up.at ? ago(up.at, t) : 'zatím ne'}. Výsledky, sestavy ani statistiky neukazujeme, nemáme na ně ověřený zdroj. <a href="/pruvodce/zakladni-hraci-doba-vs-prodlouzeni/">Proč se nepočítá prodloužení?</a> · <a href="/metodika/">Odkud bereme data</a></p>
    </aside>
  </div>
</Base>
<style is:global>
  .chart-panel { display: none; }
  .charts:has(input[name='vo'][value='1']:checked):has(input[name='vp'][value='24h']:checked) .chart-panel[data-k='1-24h'],
  .charts:has(input[name='vo'][value='1']:checked):has(input[name='vp'][value='3d']:checked) .chart-panel[data-k='1-3d'],
  .charts:has(input[name='vo'][value='1']:checked):has(input[name='vp'][value='vse']:checked) .chart-panel[data-k='1-vse'],
  .charts:has(input[name='vo'][value='x']:checked):has(input[name='vp'][value='24h']:checked) .chart-panel[data-k='x-24h'],
  .charts:has(input[name='vo'][value='x']:checked):has(input[name='vp'][value='3d']:checked) .chart-panel[data-k='x-3d'],
  .charts:has(input[name='vo'][value='x']:checked):has(input[name='vp'][value='vse']:checked) .chart-panel[data-k='x-vse'],
  .charts:has(input[name='vo'][value='2']:checked):has(input[name='vp'][value='24h']:checked) .chart-panel[data-k='2-24h'],
  .charts:has(input[name='vo'][value='2']:checked):has(input[name='vp'][value='3d']:checked) .chart-panel[data-k='2-3d'],
  .charts:has(input[name='vo'][value='2']:checked):has(input[name='vp'][value='vse']:checked) .chart-panel[data-k='2-vse'] { display: block; }
</style>
