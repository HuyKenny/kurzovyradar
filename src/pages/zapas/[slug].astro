---
import Base from '../../layouts/Base.astro';
import Ticket from '../../components/Ticket.astro';
import OddsChart, { type Series } from '../../components/OddsChart.astro';
import BookLogo from '../../components/BookLogo.astro';
import FavButton from '../../components/FavButton.astro';
import Art from '../../components/Art.astro';
import { BOOK, FEED_BOOKS, type FeedBook } from '../../config/bookmakers';
import { SPORTS, stubColor } from '../../config/competitions';
import { E, upcoming, radar as getRadar, eventDetail, listable, cfg as getCfg, now as getNow, cacheHeader } from '../../lib/data';
import { reasons, pricesFor, MIN_DIFF_PCT } from '../../lib/picks';
import { winCondition, outcomeSentence, settlement, payoutSentence, betTarget, selectionName } from '../../lib/market';
import BonusCard from '../../components/BonusCard.astro';
import { priceAgreement, AGREEMENT_TEXT, oddsPair } from '../../lib/agreement';
import { rank as rankBonuses, isFresh as bonusFresh } from '../../lib/bonus';
import { parseBetState, trhOf, winnings, payoutDelta, type FindingKey } from '../../lib/bet-state';
import { availablePeriods, changeAsOf, periodInfo, type Change } from '../../lib/context';
import { backLink, isOutcome } from '../../lib/links';
import Icon from '../../components/Icon.astro';
import { ticketView, atBooks, STATE_TEXT, outcomesFor, whoOf } from '../../lib/ticket';
import { odds as fmt, pct, dateTime, date, time, kickoff, ago, kc, atTime, dayKey } from '../../lib/format';
import { changePct, overround, implied } from '../../server/calc/odds';
import type { Outcome } from '../../server/types';

const m = /^(.*)-(\d+)$/.exec(Astro.params.slug ?? '');
if (!m) return Astro.rewrite('/404/');
const id = Number(m[2]);
// The three reads are independent: start them together (the event row, the snapshot for the comparison, the radar for the reasons).
const [d, up, rd] = await Promise.all([eventDetail(id), upcoming(), getRadar()]);
if (!d) return Astro.rewrite('/404/');
const { ev, history } = d;
if (Astro.url.pathname !== ev.url) return Astro.redirect(ev.url, 301);
const t = getNow();
const cfg = getCfg();
// The recorded history stays useful after kick-off, so the page stays (indexable) until the daily cleanup removes its rows
// (HISTORY_DAYS); only then it answers 410. One rule, independent of feed outages.
if (ev.startAt < t - cfg.historyDays * 86400) return new Response('Zápas skončil a jeho kurzy už nezobrazujeme.', { status: 410, headers: { 'content-type': 'text/plain; charset=utf-8' } });
const books = up.books;
const started = ev.startAt <= t;
const v = ticketView(ev, books, t, cfg);
const OUTS = outcomesFor(ev);
const comparable = FEED_BOOKS.filter((b) => ev.books[b] && !ev.books[b]!.mismatch);
const offer = (b: FeedBook, o: Outcome) => ev.books[b]?.outcomes[o];

// ONE chosen bet drives the whole page: calculator, name, conditions, reasons, price comparison, chart, follow button and
// links all read the same state (outcome, stake, period). It lives in the URL (see lib/bet-state.ts); src/scripts/bet.ts
// switches it in the browser without a reload. Every outcome's parts are rendered here, the others are `hidden`.
const q = Astro.url.searchParams;
const bs = parseBetState(q, v.favourite?.outcome ?? '1');
const pick: Outcome = OUTS.includes(bs.outcome) ? bs.outcome : OUTS[0]!;
const stake = bs.stake;
const back = backLink(q.get('zpet'));
const allReasons = reasons(up, rd, t, cfg);
const oddsOf = (o: Outcome) => v.outcomes.find((x) => x.outcome === o)?.best?.odds ?? null;
const sel = (o: Outcome) => selectionName(ev.sport, o, ev.home, ev.away, ev.market);
const betData = JSON.stringify({
  outcomes: Object.fromEntries(OUTS.map((o) => [o, { name: sel(o), who: whoOf(ev, o), odds: oddsOf(o) }])),
  defaultOutcome: v.favourite?.outcome ?? '1',
  market: ev.market,
});
const followBet = JSON.stringify({ id: ev.id, outcome: pick, url: ev.url, home: ev.home, away: ev.away, startAt: ev.startAt, comp: ev.compName, sport: ev.sport,
  pickFrom: '[data-bet-root]', labels: Object.fromEntries(OUTS.map((o) => [o, whoOf(ev, o)])), oddsBy: Object.fromEntries(OUTS.map((o) => [o, oddsOf(o)])) });
const topBonus = rankBonuses().find((b) => bonusFresh(b, Date.now()));
const FINDING_LABEL: Record<FindingKey, string> = { rust: 'Kurz vzrostl', pokles: 'Kurz klesl', rozdil: 'Vyšší kurz u druhé kanceláře', max: 'Nejvyšší zachycený kurz' };

// Tracking window and data gaps (failed import runs).
const firstAt = history.length ? Math.min(...history.map((h) => h.at)) : null;
const endAt = Math.min(t, ev.startAt);
const gaps: { from: number; to: number }[] = [];
if (firstAt) {
  const runs = await E.DB.prepare("SELECT book, started_at FROM import_runs WHERE status = 'error' AND started_at BETWEEN ? AND ? ORDER BY started_at")
    .bind(firstAt, endAt).all<{ book: string; started_at: number }>();
  const step = cfg.importIntervalMin * 60;
  for (const r of runs.results) {
    const last = gaps[gaps.length - 1];
    if (last && r.started_at - last.to <= step) last.to = r.started_at + step;
    else gaps.push({ from: r.started_at, to: r.started_at + step });
  }
}
const span = firstAt ? endAt - firstAt : 0;
// Periods are offered only when the whole period is covered by our records; a requested one we cannot cover falls back honestly.
const periods = availablePeriods(firstAt, endAt);
const reqPeriod = bs.period;
const period = reqPeriod && periods.some((p) => p.key === reqPeriod) ? reqPeriod : 'vse';
const periodNote = reqPeriod && period !== reqPeriod ? `Pro období „${periodInfo(reqPeriod).label}“ zatím nemáme dost zápisů, ukazujeme celé sledování.` : '';
const secondsOf = (k: string) => (k === 'vse' ? span : periodInfo(k as never).seconds ?? span);
const checkedAtOf = (bs_: FeedBook[]) => Math.min(...bs_.map((b) => books[b]?.lastSuccessAt ?? 0).filter(Boolean), Infinity);

/**
 * What changed at the requested period for one outcome, told once per distinct result (identical books are joined).
 * The period is measured as of the moment the radar snapshot was computed (rd.at), so the detail keeps the meaning of the
 * finding the visitor clicked even when the page is opened a while later. A change recorded after that moment is added as
 * a separate sentence, together with the time of the last check.
 */
function contextLines(o: Outcome): string[] {
  if (!reqPeriod) return [];
  const info = periodInfo(reqPeriod);
  const target = betTarget(ev.sport, o, ev.home, ev.away);
  const refAt = rd && rd.at <= t && t - rd.at < 6 * 3600 ? rd.at : t;
  const parts = comparable.filter((b) => isCurrentOffer(b, o)).map((b) => {
    const rows = history.filter((h) => h.book === b && h.outcome === o);
    const { atRef, change } = changeAsOf(rows, refAt, info.seconds, books[b]?.trackingSince ?? null);
    return { b, atRef, now: offer(b, o)?.odds ?? null, ch: change };
  });
  if (!parts.length) return [];
  const five = (n: number) => Math.round(n / 300); // both books are stored seconds apart in one run: within 5 min = the same change
  const sig = (c: Change, later: boolean) => `${c.status === 'moved' ? `m${c.from.odds}>${c.to.odds}@${five(c.from.at)}|${five(c.to.at)}` : c.status === 'unchanged' ? `u${c.odds}` : 'i'}${later ? 'L' : ''}`;
  const groups = new Map<string, { books: FeedBook[]; ch: Change; now: number | null; later: boolean }>();
  for (const p of parts) {
    const later = p.atRef !== null && p.now !== null && p.atRef !== p.now;
    const k = `${sig(p.ch, later)}|${p.now}`;
    (groups.get(k) ?? groups.set(k, { books: [], ch: p.ch, now: p.now, later }).get(k)!).books.push(p.b);
  }
  const asOf = t - refAt > 60 ? ` (stav ${dayKey(refAt) === dayKey(t) ? `v ${time(refAt)}` : dateTime(refAt)}, kdy radar zjištění spočítal)` : '';
  return [...groups.values()].flatMap(({ books: bk, ch, now: cur, later }) => {
    const where = atBooks(bk);
    const verified = checkedAtOf(bk);
    const ver = Number.isFinite(verified) ? ` Naposledy ověřeno ${atTime(verified, t)}.` : '';
    const out: string[] = [];
    if (ch.status === 'insufficient') out.push(`${info.label.charAt(0).toUpperCase()}${info.label.slice(1)}: pro toto období ${where} zatím nemáme dost zápisů, takže změnu nepočítáme.`);
    else if (ch.status === 'unchanged') out.push(`Kurz na ${target} se ${where} ${info.since} nezměnil (${fmt(ch.odds)})${asOf}.`);
    else {
      const dlt = payoutDelta(100, ch.from.odds, ch.to.odds);
      out.push(`Kurz na ${target} ${where} ${ch.to.odds < ch.from.odds ? 'klesl' : 'stoupl'} ${info.since} z ${fmt(ch.from.odds)} na ${fmt(ch.to.odds)} (${pct(ch.pct)})${asOf}. Při vkladu 100 Kč je to ${Math.abs(dlt)} Kč ${dlt < 0 ? 'nižší' : 'vyšší'} výplata při výhře. Porovnáváme zápis z ${dateTime(ch.from.at)} se zápisem z ${dateTime(ch.to.at)}.`);
    }
    if (later && cur !== null) out.push(`Od té doby se kurz ${where} změnil na ${fmt(cur)}.${ver}`);
    else out.push(ver.trim());
    return out.filter(Boolean);
  });
}
function isCurrentOffer(b: FeedBook, o: Outcome) { return pickPricesAll[o].some((x) => x.book === b); }
const pickPricesAll = Object.fromEntries(OUTS.map((o) => [o, pricesFor(ev, o, up, t, cfg)])) as Record<Outcome, ReturnType<typeof pricesFor>>;
const series = (o: Outcome): Series[] => comparable.map((b) => ({ book: b, points: history.filter((h) => h.book === b && h.outcome === o) })).filter((s) => s.points.length);
const enough = history.length > 0;

// What happened, in sentences. Identical books are told once.
const story: string[] = [];
for (const o of OUTS) {
  const who = betTarget(ev.sport, o, ev.home, ev.away);
  const parts = comparable.map((b) => ({ b, x: offer(b, o) })).filter((p) => p.x);
  if (!parts.length) continue;
  const sameAll = parts.every((p) => p.x!.odds === parts[0]!.x!.odds && p.x!.firstOdds === parts[0]!.x!.firstOdds);
  const groups = sameAll ? [{ books: parts.map((p) => p.b), x: parts[0]!.x! }] : parts.map((p) => ({ books: [p.b], x: p.x! }));
  for (const g of groups) {
    const where = atBooks(g.books);
    if (g.x.odds === g.x.firstOdds) story.push(`Kurz na ${who} se ${where} od začátku sledování nezměnil (${fmt(g.x.odds)}).`);
    else story.push(`Kurz na ${who} ${where} ${g.x.odds < g.x.firstOdds ? 'klesl' : 'stoupl'} z ${fmt(g.x.firstOdds)} na ${fmt(g.x.odds)} (${pct(changePct(g.x.firstOdds, g.x.odds))}).`);
  }
}
const margins = comparable.map((b) => ({ b, v: overround(Object.fromEntries(OUTS.map((o) => [o, offer(b, o)?.odds ? offer(b, o)!.odds / 1000 : undefined])), OUTS) }))
  .filter((x) => x.v !== null);
const related = listable(up, t, cfg).filter((e) => e.comp === ev.comp && e.id !== ev.id).slice(0, 4);
const S = SPORTS[ev.sport];
const title = `${ev.home} – ${ev.away}: kurzy a jejich vývoj (${date(ev.startAt)}) | KurzovýRadar`;
const bestLine = OUTS.map((o) => { const p = pickPricesAll[o][0]; return p ? `${betTarget(ev.sport, o, ev.home, ev.away)} ${fmt(p.odds)}` : null; }).filter(Boolean).join(', ');
const desc = `Kurzy na zápas ${ev.home} – ${ev.away} (${ev.compName}, ${date(ev.startAt)} ${time(ev.startAt)})${bestLine ? `: nejvyšší kurzy ${bestLine}` : ''}. Tipsport a Chance vedle sebe a jak se kurz měnil.`;
// A WebPage about the match: Google wants a venue (`location`) for an Event rich result and we do not know it, so the match is only described.
const schema = [{ '@type': 'WebPage', url: new URL(ev.url, 'https://kurzovyradar.cz').href, name: `${ev.home} – ${ev.away}: kurzy a jejich vývoj`, inLanguage: 'cs', about: {
  '@type': 'SportsEvent', name: `${ev.home} – ${ev.away}`, startDate: new Date(ev.startAt * 1000).toISOString(), sport: S.name,
  eventStatus: 'https://schema.org/EventScheduled', url: new URL(ev.url, 'https://kurzovyradar.cz').href, description: `Kurzy a jejich vývoj na zápas ${ev.home} – ${ev.away}.`,
  homeTeam: { '@type': 'SportsTeam', name: ev.home }, awayTeam: { '@type': 'SportsTeam', name: ev.away },
  superEvent: { '@type': 'SportsEvent', name: ev.compName },
} }];
const offState = (o: (typeof v.outcomes)[number]) => STATE_TEXT[o.cells.find((c) => c.state !== 'missing')?.state ?? 'missing'];
const lastKnown = (o: Outcome) => comparable.map((b) => offer(b, o)).find(Boolean);
// Coming from the radar (zjisteni/obdobi) the page must match what the radar just showed: short edge cache for those.
Astro.response.headers.set('Cache-Control', q.has('zjisteni') || q.has('obdobi') ? 'public, max-age=0, s-maxage=60' : cacheHeader());
---
<Base title={title} description={desc} schema={schema} noindex={!enough || q.size > 0} canonical={ev.url}
  crumbs={[{ name: S.name, url: S.path }, { name: ev.compName, url: `/souteze/${ev.comp}/` }, { name: `${ev.home} – ${ev.away}`, url: ev.url }]}>
  <div class="wrap pt-6" data-bet-root data-bet={betData}>
    {back && <p class="m-0 mb-4"><a href={back.href} class="font-bold inline-flex items-center gap-1 min-h-[44px] no-underline hover:underline"><span aria-hidden="true">←</span>{back.label}</a></p>}
    <article class="ticket" id="sazka">
      <div class="ticket__stub" style={`background:${stubColor(ev.comp, ev.sport)}`}>
        <Art name={ev.sport} size={22} />
        <a href={`/souteze/${ev.comp}/`} class="text-ink no-underline hover:underline">{ev.compName}</a>
        <time class="ml-auto num normal-case tracking-normal text-base" datetime={new Date(ev.startAt * 1000).toISOString()}>{kickoff(ev.startAt, t)}</time>
      </div>
      <div class="p-5 md:p-7 grid gap-6 lg:grid-cols-[minmax(0,1fr)_380px]">
        <div class="min-w-0">
          <h1 class="m-0 text-balance">{ev.home} <span class="text-ink-3 font-normal">vs</span> {ev.away}</h1>
          <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-ink-2">
            {firstAt && <span>Kurzy sledujeme od {dateTime(firstAt)}</span>}
            <FavButton ev={ev} big odds={Object.fromEntries(v.outcomes.filter((o) => o.best).map((o) => [o.outcome, o.best!.odds]))} />
          </div>
          {started && <p class="note-box mt-4 mb-0">Zápas už začal. Ukazujeme poslední kurzy před výkopem. Kurzy během zápasu nesledujeme.</p>}
          <h2 class="text-[1.25rem] mt-6 mb-3">Kolik kdo vyplácí</h2>
          {v.books.length === 0 && !started ? <p class="m-0">Kurzy teď nejsou v nabídce. Zkontrolujeme je znovu za pár minut.</p> : (
            <ul class:list={['grid gap-2 sm:gap-3 list-none p-0 m-0', OUTS.length === 2 ? 'grid-cols-2' : 'grid-cols-3']}>
              {v.outcomes.map((o) => (
                <li class="min-w-0 relative" data-odd-for={o.outcome}>
                  <span class="odd-picked-tag" data-picked-tag hidden={o.outcome !== pick}>vybráno</span>
                  {o.best ? (
                    <a href={`/go/${o.best.books[0]}/?e=${ev.id}&p=detail`} rel="sponsored nofollow" class:list={['odd !min-h-[72px]', !o.same && v.books.length > 1 && 'odd--best']}
                      aria-label={`${o.who}: kurz ${fmt(o.best.odds)} ${atBooks(o.best.books)}`}>
                      <span class="odd__who">{o.who}</span><span class="odd__val !text-[1.6rem]">{fmt(o.best.odds)}</span>
                      {!o.same && v.books.length > 1 && <span class="text-[0.8rem] font-bold text-green-ink">víc {BOOK[o.best.books[0]!].locative}</span>}
                    </a>
                  ) : (
                    <span class="odd odd--off !min-h-[72px]"><span class="odd__who">{o.who}</span><span class="odd__val">{lastKnown(o.outcome) ? fmt(lastKnown(o.outcome)!.odds) : '–'}</span><span class="text-[0.8rem]">{offState(o)}</span></span>
                  )}
                </li>
              ))}
            </ul>
          )}
          {v.allSame && <p class="mt-3 mb-0 flex flex-wrap items-center gap-2 text-ink-2"><span class="inline-flex gap-1">{v.books.map((b) => <BookLogo id={b} h={20} />)}</span>Ceny {OUTS.length === 2 ? 'obou sázek' : 'všech tří sázek'} jsou teď {atBooks(v.books)} stejné.</p>}
          {v.books.length > 1 && !v.allSame && (
            <table class="w-full mt-3 text-[1rem]">
              <caption class="sr">Kurzy podle kanceláří</caption>
              <thead><tr class="text-ink-2 text-[0.9rem]"><th scope="col" class="text-left font-normal pb-1">Kancelář</th>{v.outcomes.map((o) => <th scope="col" class="font-normal pb-1 leading-tight [overflow-wrap:anywhere]">{o.who}</th>)}</tr></thead>
              <tbody>{v.books.map((b) => (
                <tr class="border-t border-line"><th scope="row" class="text-left py-1.5 font-normal"><BookLogo id={b} h={20} /></th>
                  {v.outcomes.map((o) => { const c = o.cells.find((x) => x.book === b)!; return <td class:list={['num text-center', o.best && c.current && c.odds === o.best.odds ? 'font-bold' : 'text-ink-2']}>{c.current && c.odds ? fmt(c.odds) : '–'}</td>; })}</tr>
              ))}</tbody>
            </table>
          )}
          <p class="mt-4 mb-0 text-[0.95rem] text-ink-2">{settlement(ev.sport, ev.market)} {v.checkedAt && <>Zkontrolováno v {time(v.checkedAt)}.</>}</p>
          {!started && comparable.some((b) => BOOK[b].affiliate === 'approved') && (
            <div class="flex flex-wrap gap-2 mt-5">
              {comparable.filter((b) => BOOK[b].affiliate === 'approved').map((b) => <a class="btn btn--ghost" href={`/go/${b}/?e=${ev.id}&p=detail`} rel="sponsored nofollow"><BookLogo id={b} h={20} />Vsadit {BOOK[b].locative}</a>)}
            </div>
          )}
        </div>

        <form id="kalkulacka" method="get" action={`${ev.url}#kalkulacka`} class="bg-green-soft border-2 border-ink rounded-[14px] p-4 self-start grid gap-3" data-bet-form>
          <h2 class="text-[1.25rem] m-0 flex items-center gap-2"><Art name="kalkulacka" size={28} />Kolik vyhraju?</h2>
          <input type="hidden" name="trh" value={trhOf(ev.market)} />
          {q.get('zpet') && <input type="hidden" name="zpet" value={q.get('zpet')!} />}
          {bs.period && <input type="hidden" name="obdobi" value={bs.period} />}
          {bs.finding && <input type="hidden" name="zjisteni" value={bs.finding} />}
          <label class="grid gap-1 font-bold text-[0.95rem]">Vsadím (Kč)<input class="field num" name="vklad" inputmode="decimal" value={String(stake)} data-bet-stake autocomplete="off" /></label>
          <fieldset class="m-0 p-0 border-0">
            <legend class="font-bold text-[0.95rem] mb-1">Na co</legend>
            <div class:list={['pick', v.outcomes.length === 2 ? 'pick--2' : 'pick--3']}>
              {v.outcomes.map((o) => <label><input type="radio" name="vysledek" value={o.outcome} checked={o.outcome === pick} disabled={!o.best} data-bet-outcome /><span><span class="pick__who">{o.who}</span><span class="pick__odds num">{o.best ? fmt(o.best.odds) : '–'}</span></span></label>)}
            </div>
          </fieldset>
          <p class="m-0 text-[0.95rem]"><span class="text-ink-2">Vybraná sázka:</span> <strong data-bind="name">{sel(pick)}</strong>{' '}<span class="text-ink-2" data-bind="who-wrap">({whoOf(ev, pick)})</span>, kurz <strong class="num" data-bind="odds">{oddsOf(pick) ? fmt(oddsOf(pick)!) : '–'}</strong></p>
          <output class="block text-[1.1rem]" aria-live="polite" data-out>
            {oddsOf(pick) ? <>Pokud sázka vyhraje, dostaneš <strong class="num">{kc(winnings(stake, oddsOf(pick)!).payout)}</strong> včetně vkladu. Čistý zisk je <strong class="num">{kc(winnings(stake, oddsOf(pick)!).profit)}</strong>. Pokud prohraje, ztratíš vklad <strong class="num">{kc(stake)}</strong>.</> : 'Na tenhle výsledek teď kurz nemáme.'}
          </output>
          <button class="btn btn--sm justify-self-start" type="submit" data-nojs>Spočítat</button>
          <button type="button" hidden class="btn btn--ghost btn--sm justify-self-start follow-bet" data-follow-bet={followBet} aria-pressed="false"><Icon name="star" size={16} /><span data-follow-label>Sledovat změny</span></button>
          <div data-target-box hidden class="grid gap-2 border-t-2 border-ink pt-3">
            <label class="grid gap-1 font-bold text-[0.95rem]">Cílový kurz (volitelné)<input class="field num" type="text" inputmode="decimal" placeholder="např. 2,10" data-target-input aria-describedby="cil-pozn" /></label>
            <div class="flex flex-wrap gap-2"><button type="button" class="btn btn--sm" data-target-save>Nastavit cíl</button><button type="button" class="btn btn--ghost btn--sm" data-target-clear hidden>Zrušit cíl</button></div>
            <p class="m-0 text-[0.92rem]" data-target-status role="status"></p>
            <p id="cil-pozn" class="m-0 text-[0.82rem] text-ink-2">Cíl se vyhodnotí, když otevřeš web. Neposíláme e-mail ani upozornění.</p>
          </div>
          <p class="m-0 text-[0.85rem] text-ink-2">Počítáme s nejvyšším aktuálním kurzem. Daně a podmínky kanceláře nezahrnujeme.</p>
        </form>
      </div>
    </article>

    {/* Order: comparison and calculator above, then what happened (summary + chart), then where it is higher (partner links), the history table, and only then the commercial bonus block. */}
    {enough && (
      <section class="mt-12" aria-labelledby="h-story">
        <h2 id="h-story" class="flex items-center gap-2"><Art name="radar" size={34} />Co se s kurzy dělo od začátku našeho sledování</h2>
        <ul class="mt-3 grid gap-2 text-[1.08rem] max-w-[75ch] list-none p-0">
          {story.map((s) => <li class="flex gap-2"><span class="hand text-[1.3rem] leading-none" aria-hidden="true">→</span><span>{s}</span></li>)}
        </ul>
      </section>
    )}

    <section class="mt-12" aria-labelledby="h-hist" id="graf">
      <h2 id="h-hist" class="m-0">Vývoj kurzu v grafu</h2>
      {!enough ? <p class="card p-5 mt-4">Pro tenhle zápas zatím nemáme dost zápisů.</p> : (
        <form class="charts mt-4 card p-4 md:p-6" method="get" action={`${ev.url}#graf`} data-bet-form>
          <input type="hidden" name="trh" value={trhOf(ev.market)} />
          <input type="hidden" name="vklad" value={String(stake)} />
          {q.get('zpet') && <input type="hidden" name="zpet" value={q.get('zpet')!} />}
          {bs.finding && <input type="hidden" name="zjisteni" value={bs.finding} />}
          <div class="flex flex-wrap gap-3 justify-between">
            <div class="seg" role="radiogroup" aria-label="Výsledek">
              {OUTS.map((o) => <label><input type="radio" name="vysledek" value={o} checked={o === pick} data-bet-outcome /><span>{whoOf(ev, o)}</span></label>)}
            </div>
            <div class="seg" role="radiogroup" aria-label="Období">
              {periods.map((p) => <label><input type="radio" name="obdobi" value={p.key} checked={p.key === period} data-bet-period /><span>{p.label}</span></label>)}
            </div>
          </div>
          <button class="btn btn--sm mt-3" type="submit" data-nojs>Zobrazit</button>
          <p class="mt-3 mb-0 font-bold" data-bind="chart-title">{sel(pick)} ({whoOf(ev, pick)}), období: {periodInfo(period).label}</p>
          {periodNote && <p class="mt-1 mb-0 note-box">{periodNote}</p>}
          {OUTS.flatMap((o) => periods.map((p) => (
            <div class="chart-panel mt-4" data-k={`${o}-${p.key}`} hidden={!(o === pick && p.key === period)}>
              {series(o).length ? <>
                <div class="sm:hidden"><OddsChart id={`chm-${o}-${p.key}`} w={340} h={230} series={series(o)} from={Math.max(firstAt!, endAt - secondsOf(p.key))} to={endAt} gaps={gaps}
                  label={`Vývoj kurzu na ${o === 'x' ? 'remízu' : whoOf(ev, o)} (${p.label})`} /></div>
                <div class="hidden sm:block max-w-[820px]"><OddsChart id={`ch-${o}-${p.key}`} w={780} h={300} series={series(o)} from={Math.max(firstAt!, endAt - secondsOf(p.key))} to={endAt} gaps={gaps}
                  label={`Vývoj kurzu na ${o === 'x' ? 'remízu' : whoOf(ev, o)} (${p.label})`} /></div>
              </> : <p>Na tenhle výsledek nemáme zápisy.</p>}
            </div>
          )))}
          <p class="mt-3 mb-0 text-ink-2">Čára ukazuje jen kurzy, které jsme při kontrolách opravdu zapsali; mezi kontrolami se kurz mohl změnit i víckrát. {gaps.length ? `Šedé pásy jsou chvíle, kdy se nám data nepodařilo načíst (${gaps.length}×).` : ''}</p>
        </form>
      )}
    </section>

    <section class="mt-12" aria-labelledby="h-bet">
      <p class="hand m-0 text-[1.3rem]">tvoje sázka</p>
      {OUTS.map((o) => {
        const prices = pickPricesAll[o];
        const why = allReasons.get(`${ev.id}|${o}`) ?? [];
        const ctx = contextLines(o);
        return (
          <div data-bet-panel={o} hidden={o !== pick}>
            <h2 id={o === pick ? 'h-bet' : undefined} class="m-0 mt-1">{outcomeSentence(ev.sport, o, ev.home, ev.away, ev.market)}</h2>
            <p class="mt-2 mb-5 text-ink-2"><strong class="text-ink">{sel(o)}.</strong> {settlement(ev.sport, ev.market)} Jinou sázku vybereš v kalkulačce nahoře nebo u grafu.</p>
            <div class="grid gap-5 lg:grid-cols-3">
              <div class="card p-5">
                <h3 class="m-0 mb-2">Co musí nastat, aby sázka vyhrála?</h3>
                <ul class="m-0 pl-5 list-disc grid gap-1.5">{winCondition(ev.sport, o, ev.home, ev.away, ev.market).map((x) => <li>{x}</li>)}</ul>
              </div>
              <div class="card p-5">
                <h3 class="m-0 mb-2">Proč ji radar vybral?</h3>
                {bs.finding && reqPeriod && o === bs.outcome && <p class="m-0 mb-2"><span class="badge badge--grey mr-1">Z radaru</span> Přišel jsi od zjištění „{FINDING_LABEL[bs.finding]}“ {periodInfo(reqPeriod).since}.</p>}
                {ctx.length > 0 && <ul class="m-0 pl-0 list-none grid gap-2 mb-2">{ctx.map((c) => <li>{c}</li>)}</ul>}
                {why.length ? (
                  <ul class="m-0 pl-0 list-none grid gap-2">{why.map((r) => <li><span class:list={['badge mr-1', r.type === 'one-moved' || r.type === 'higher-elsewhere' ? 'badge--green' : 'badge--orange']}>{r.label}</span> {r.text}</li>)}</ul>
                ) : !ctx.length ? <p class="m-0">Mezi dnešními zajímavostmi tahle sázka není: {priceAgreement(prices) === 'same' ? 'u obou kanceláří je stejný kurz' : priceAgreement(prices) === 'slight' ? `kurzy se liší jen mírně (pod ${MIN_DIFF_PCT} %)` : 'pro srovnání kanceláří nemáme dost aktuálních údajů'} a výrazně se nepohnul. Ukazujeme ji, protože sis ji otevřel.</p> : null}
                <p class="mt-3 mb-0 text-[0.88rem] text-ink-2">Je to zjištění z dat, ne tip. Důvod změn kanceláře neuvádějí.</p>
              </div>
              <div class="card p-5">
                <h3 class="m-0 mb-2">Kde je nyní vyšší kurz?</h3>
                {prices.length === 0 ? <p class="m-0">Na „{whoOf(ev, o)}“ teď nemáme aktuální kurz žádné kanceláře.</p>
                  : prices.length === 1 ? <p class="m-0">Aktuální kurz máme jen {BOOK[prices[0]!.book].locative}: {fmt(prices[0]!.odds)} (ověřeno {time(prices[0]!.checkedAt)}). Druhou kancelář teď porovnat nejde.</p>
                  : priceAgreement(prices) === 'same'
                    ? <p class="m-0">{AGREEMENT_TEXT.same} {atBooks(prices.map((x) => x.book)).replace(/^u /, 'U ')}: {fmt(prices[0]!.odds)} (ověřeno {time(Math.min(...prices.map((x) => x.checkedAt)))}).</p>
                    : <p class="m-0">{AGREEMENT_TEXT[priceAgreement(prices)]} Vyšší je {BOOK[prices[0]!.book].locative}: {oddsPair(prices[0]!.odds, prices[1]!.odds)[0]} proti {oddsPair(prices[0]!.odds, prices[1]!.odds)[1]} {BOOK[prices[1]!.book].locative} (ověřeno {time(Math.min(...prices.map((x) => x.checkedAt)))}).</p>}
                {prices[0] && <p class="mt-3 mb-0">{payoutSentence(100, prices[0].odds)}</p>}
                {!started && prices[0] && <>
                  <a class="btn btn--sm mt-4" href={`/go/${prices[0].book}/?e=${ev.id}&p=sazka-${o}`} rel="sponsored nofollow">Zobrazit zápas {BOOK[prices[0].book].locative}<Icon name="external-link" size={15} /></a>
                  <p class="mt-2 mb-0 text-[0.85rem] text-ink-2">Otevře se zápas na webu kanceláře. Sázku „{sel(o)}“ si tam vybereš sám, kancelář konkrétní výsledek v odkazu nepřebírá.</p>
                </>}
              </div>
            </div>
          </div>
        );
      })}
    </section>

    {enough && (
      <details class="mt-10 card card--flat">
        <summary class="px-5 min-h-[56px] flex items-center font-display font-bold text-lg">Pro detailisty: marže, minimum a maximum, všechny zápisy</summary>
        <div class="px-5 pb-5 grid gap-6">
          <ul class="m-0 grid gap-1.5 pl-5 list-disc">
            {v.outcomes.filter((o) => o.best).map((o) => <li>Kurz {fmt(o.best!.odds)} na „{o.who}“ odpovídá zhruba {Math.round(implied(o.best!.odds / 1000) * 100)} % šanci. Je to jen kurz převedený na procenta včetně marže kanceláře, ne skutečná pravděpodobnost.</li>)}
            {margins.map((x) => <li>Marže {BOOK[x.b].locative} na tomto zápase je {pct(x.v! * 100, false)} (součet převrácených kurzů 1, X a 2 minus 100 %).</li>)}
          </ul>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[560px] text-[0.97rem]">
              <thead><tr class="text-ink-2 text-[0.9rem] border-b-2 border-ink">
                <th scope="col" class="text-left py-2">Výsledek</th><th scope="col" class="text-left py-2">Kancelář</th>
                <th scope="col" class="text-right py-2">První zápis</th><th scope="col" class="text-right py-2">Teď</th>
                <th scope="col" class="text-right py-2">Nejníž</th><th scope="col" class="text-right py-2">Nejvýš</th>
              </tr></thead>
              <tbody>
                {OUTS.flatMap((o) => comparable.map((b) => {
                  const x = offer(b, o);
                  if (!x) return null;
                  return (
                    <tr class="border-b border-line">
                      <th scope="row" class="text-left py-2 font-normal">{whoOf(ev, o)}</th><td>{BOOK[b].name}</td>
                      <td class="text-right num">{fmt(x.firstOdds)} <span class="text-ink-2 text-[0.85rem]">{dateTime(x.firstAt)}</span></td>
                      <td class="text-right num font-bold">{fmt(x.odds)}</td>
                      <td class="text-right num">{fmt(x.minOdds)}</td><td class="text-right num">{fmt(x.maxOdds)}</td>
                    </tr>
                  );
                }))}
              </tbody>
            </table>
          </div>
          <details>
            <summary class="font-bold min-h-[44px] flex items-center">Všechny zápisy ({history.length})</summary>
            <div class="overflow-x-auto">
              <table class="w-full text-[0.92rem] min-w-[480px]">
                <thead><tr class="text-ink-2 border-b border-line"><th scope="col" class="text-left py-2">Čas zápisu</th><th scope="col" class="text-left py-2">Kancelář</th><th scope="col" class="text-left py-2">Výsledek</th><th scope="col" class="text-right py-2">Kurz</th><th scope="col" class="text-left py-2 pl-3">Stav</th></tr></thead>
                <tbody>{history.map((h) => <tr class="border-b border-line"><td class="py-1.5 num">{dateTime(h.at)}</td><td>{BOOK[h.book].name}</td><td>{whoOf(ev, h.outcome)}</td><td class="text-right num">{fmt(h.odds)}</td><td class="pl-3">{h.enabled ? 'v nabídce' : 'pozastaveno'}</td></tr>)}</tbody>
              </table>
            </div>
          </details>
        </div>
      </details>
    )}

    {!started && topBonus && (
      <section class="mt-10 max-w-[760px]" aria-label="Bonus pro nové hráče"><BonusCard b={topBonus} placement="bonus-detail" compact /></section>
    )}

    {related.length > 0 && (
      <section class="mt-14" aria-labelledby="h-rel">
        <h2 id="h-rel" class="mb-5">Další zápasy – {ev.compName}</h2>
        <div class="grid gap-5 lg:grid-cols-2">{related.map((r) => <Ticket ev={r} books={books} now={t} cfg={cfg} place="related" showComp={false} />)}</div>
      </section>
    )}

    <aside class="mt-12 max-w-[80ch] text-ink-2">
      <p class="m-0">Kurzy kontrolujeme každých {cfg.importIntervalMin} minut a zapíšeme, co se od minulé kontroly změnilo. Změny mezi kontrolami nevidíme. Data jsme naposledy obnovili {up.at ? ago(up.at, t) : 'zatím ne'}. Výsledky, sestavy ani statistiky neukazujeme, nemáme na ně ověřený zdroj. <a href="/pruvodce/zakladni-hraci-doba-vs-prodlouzeni/">Proč se nepočítá prodloužení?</a> · <a href="/metodika/">Odkud bereme data</a></p>
    </aside>
  </div>
</Base>
<script src="../../scripts/bet.ts"></script>
