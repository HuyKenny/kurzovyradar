---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ticket from '../components/Ticket.astro';
import FindingCard from '../components/FindingCard.astro';
import { fromMove } from '../lib/findings';
import BonusCard from '../components/BonusCard.astro';
import { rank as rankBonuses, isFresh as bonusFresh } from '../lib/bonus';
import BookLogo from '../components/BookLogo.astro';
import Icon from '../components/Icon.astro';
import Art from '../components/Art.astro';
import HowOdds from '../components/HowOdds.astro';
import BetCard from '../components/BetCard.astro';
import { picks as pickList, MIN_DIFF_PCT, BIG_MOVE_PCT, MIN_HIGH_PCT } from '../lib/picks';
import Photo from '../components/Photo.astro';
import art from '../data/art.json';
import { BOOKMAKERS } from '../config/bookmakers';
import { competitionsIn, sportsIn } from '../lib/catalog';
import { upcoming, radar, listable, lastCheck, mergeMoves, cfg as getCfg, now as getNow, cacheHeader } from '../lib/data';
import { int, time, dayKey } from '../lib/format';
import { ticketView } from '../lib/ticket';
import { WINDOWS } from '../server/view';

const [up, rd, guides] = await Promise.all([upcoming(), radar(), getCollection('pruvodce')]);
guides.sort((a, b) => a.data.order - b.data.order);
const t = getNow();
const cfg = getCfg();
const events = listable(up, t, cfg);
const sport = Astro.url.searchParams.get('sport') === 'hokej' ? 'hokej' : 'fotbal';
const soon = events.filter((e) => e.sport === sport && e.startAt <= t + 2 * 86400);
const next = (soon.length >= 4 ? soon : events.filter((e) => e.sport === sport)).slice(0, 6);
const checked = lastCheck(up);
const chosen = pickList(up, rd, t, cfg);
const win = rd ? [...WINDOWS].reverse().find((w) => rd.windows[w.key].available) : undefined;
const moves = win && rd
  ? [...mergeMoves(rd.windows[win.key].drops.filter((m) => m.startAt > t)).slice(0, 2), ...mergeMoves(rd.windows[win.key].rises.filter((m) => m.startAt > t)).slice(0, 1)].map((m) => fromMove(m, win.key))
  : [];
const checkedOf = (books: string[]) => { const v = books.map((b) => up.books[b as 'tipsport']?.lastSuccessAt ?? 0).filter(Boolean); return v.length ? Math.min(...v) : null; };
const comps = competitionsIn(events).slice(0, 18);
const sportList = sportsIn(events);
const bonusList = rankBonuses().filter((b) => bonusFresh(b, Date.now()));
const counts = { fotbal: events.filter((e) => e.sport === 'fotbal').length, hokej: events.filter((e) => e.sport === 'hokej').length };
const today = events.filter((e) => dayKey(e.startAt) === dayKey(t)).length;
// Real example for the explainer: the first listed favourite, else a neutral 1,85.
const ex = next.map((e) => ({ e, v: ticketView(e, up.books, t, cfg) })).find((x) => x.v.favourite?.best);
Astro.response.headers.set('Cache-Control', cacheHeader());
---
<Base title="KurzovýRadar – kurzy na sport přehledně, i jak se mění"
  description="Kolik vyplácí Tipsport a Chance za fotbal, hokej, tenis, esporty a další sporty a jestli kurz roste, nebo padá. Srozumitelně, bez registrace. Kurzy kontrolujeme každých 15 minut.">
  <section class="wrap pt-8 md:pt-14 grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
    <div>
      <p class="hand m-0 text-[1.6rem] -rotate-2 origin-left">fotbal, hokej, tenis & další, bez registrace</p>
      <h1 class="mt-2 mb-4 text-balance">Porovnej kurzy. Sleduj jejich pohyb.</h1>
      <p class="text-[1.2rem] max-w-[46ch] m-0">Uvidíš, kolik vyplatí Tipsport a Chance za fotbal, hokej, tenis, esporty a další sporty a jestli kurz roste, nebo padá.</p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/kurzy/" class="btn">Porovnat kurzy<Icon name="arrow-right" size={18} /></a>
        <a href="/radar/" class="btn btn--ghost">Otevřít radar</a>
      </div>
      {checked && <p class="mt-6 mb-0 text-ink-2 flex items-baseline gap-2"><span class="shrink-0 inline-block w-2.5 h-2.5 rounded-full bg-green border-2 border-ink" aria-hidden="true"></span><span>Naposledy zkontrolováno v {time(checked)} · {int(events.length)} zápasů s kurzy{today ? `, z toho ${today} dnes` : ''}</span></p>}
    </div>
    <div class="relative">
      {'hero' in art ? <Art name="hero" size={520} eager class="w-full h-auto" alt="" />
        : <div class="card p-2.5 rotate-[1.5deg]"><div class="rounded-[8px] overflow-hidden border-2 border-ink aspect-[4/3]"><Photo slot="hero" priority sizes="(min-width: 1024px) 520px, 100vw" class="h-full" /></div></div>}
      {ex?.v.favourite?.best && (
        <div class="ticket max-w-[340px] mx-auto lg:mx-0 lg:absolute lg:-bottom-6 lg:-left-6 rotate-[-2deg] p-4">
          <p class="eyebrow m-0">{ex.e.compName}</p>
          <p class="font-display font-bold text-lg m-0 mt-1">{ex.e.home} vs {ex.e.away}</p>
          <p class="m-0 mt-2">Kurz na {ex.v.favourite.outcome === 'x' ? 'remízu' : ex.v.favourite.who}: <strong class="num">{(ex.v.favourite.best.odds / 1000).toFixed(2).replace('.', ',')}</strong></p>
          <p class="hand m-0 mt-1">pokud vyhraje: 100 Kč → {Math.round(ex.v.favourite.best.odds / 10)} Kč</p>
        </div>
      )}
    </div>
  </section>

  <section class="wrap mt-10" aria-label="Kde začít">
    <ul class="grid gap-4 md:grid-cols-3 list-none p-0 m-0">
      <li><a href="/pruvodce/kurzy-pro-zacatecniky/#priklad" class="ticket no-underline text-ink p-5 flex flex-col gap-2 h-full">
        <Art name="pruvodce" size={52} /><span class="font-display font-bold text-[1.2rem]">Začínám a chci tomu rozumět</span>
        <span class="text-ink-2">Krátké vysvětlení a vyzkoušení výpočtu na skutečném zápase.</span>
        <span class="mt-auto font-bold text-green-ink inline-flex items-center gap-1">Vyzkoušet na příkladu<Icon name="arrow-right" size={15} /></span></a></li>
      <li><a href="/dnes/" class="ticket no-underline text-ink p-5 flex flex-col gap-2 h-full">
        <Art name="fotbal" size={52} /><span class="font-display font-bold text-[1.2rem]">Hledám dnešní zápasy</span>
        <span class="text-ink-2">{today ? `Dnes máme ${today} ${today === 1 ? 'zápas' : today < 5 ? 'zápasy' : 'zápasů'} s kurzy, které ještě nezačaly.` : 'Dnešní nabídka a zápasy na další dny.'}</span>
        <span class="mt-auto font-bold text-green-ink inline-flex items-center gap-1">Dnešní zápasy<Icon name="arrow-right" size={15} /></span></a></li>
      <li><div class="ticket p-5 flex flex-col gap-2 h-full">
        <Art name="radar" size={52} /><span class="font-display font-bold text-[1.2rem]">Už mám vybraný zápas</span>
        <form action="/hledat/" method="get" role="search" class="grid gap-2">
          <label class="grid gap-1 text-ink-2" for="q-home">Napiš tým nebo soutěž</label>
          <div class="flex gap-2"><input id="q-home" name="q" type="search" minlength="2" required placeholder="Např. Sparta" class="field flex-1 min-w-0" /><button class="btn btn--sm" type="submit">Najít</button></div>
        </form></div></li>
    </ul>
  </section>

  {bonusList.length > 0 && (
    <section class="wrap mt-14" aria-labelledby="h-bonus">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
        <div class="max-w-[70ch]">
          <p class="hand m-0 text-[1.35rem] -rotate-1 origin-left">bonus pro nové hráče</p>
          <h2 id="h-bonus" class="m-0 mt-1">Vstupní bonusy na sportovní sázky</h2>
          <p class="mt-2 mb-0 text-ink-2">Podmínky z oficiálních stránek kanceláří, nahoře ty nejmírnější. Pod číslem vždy najdeš, kolik musíš prosázet.</p>
        </div>
        <a href="/bonusy/" class="font-bold inline-flex items-center gap-1 min-h-[44px]">Všechny podmínky<Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="grid gap-5 md:grid-cols-2">{bonusList.map((b, i) => <BonusCard b={b} placement="bonus-home" compact first={i === 0 && bonusList.length > 1} />)}</div>
    </section>
  )}

  <div class="wrap mt-10" data-follow-strip hidden></div>

  <section class="wrap mt-14" aria-labelledby="h-picks" id="vybrano">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
      <div class="max-w-[70ch]">
        <p class="hand m-0 text-[1.35rem] -rotate-1 origin-left">vybráno radarem</p>
        <h2 id="h-picks" class="m-0 mt-1 flex items-center gap-2"><Art name="radar" size={34} />Dnes stojí za pozornost</h2>
        <p class="mt-2 mb-0 text-ink-2">Zápasy dnes a zítra, u kterých jsme v datech něco zjistili: jiný kurz u druhé kanceláře nebo výraznou změnu. Je to zjištění, ne tip.</p>
      </div>
    </div>
    {chosen.length ? <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{chosen.map((p) => <BetCard p={p} up={up} now={t} cfg={cfg} back="/" />)}</div> : (
      <div class="card p-6 max-w-[720px]">
        <p class="m-0 text-lg font-bold">Dnes jsme u sledovaných zápasů nenašli rozdíl mezi kancelářemi ani výraznou změnu kurzu.</p>
        <p class="mt-2 mb-0">Tipsport a Chance mají teď stejné kurzy a nic se výrazně nepohnulo. Můžeš si níže sledovat konkrétní zápas (hvězdička) a my ti ukážeme, až se u něj kurz změní.</p>
        <a href="#h-next" class="btn btn--ghost mt-4">Vybrat zápas ke sledování</a>
      </div>
    )}
    <details class="mt-5 text-ink-2 max-w-[80ch]">
      <summary class="font-bold text-ink min-h-[44px] inline-flex items-center">Jak vybíráme a řadíme</summary>
      <ul class="mt-2 mb-0 pl-5 list-disc grid gap-1">
        <li><strong>Vyšší kurz u druhé kanceláře:</strong> jedna kancelář změnila kurz a druhá ho při pozdější kontrole měla pořád původní, nebo se kurzy obou kanceláří na stejnou sázku liší aspoň o {MIN_DIFF_PCT} %.</li>
        <li><strong>Kurz klesl / Kurz vzrostl:</strong> kurz se za sledované období změnil aspoň o {BIG_MOVE_PCT} %. Karta řekne, jestli klesl, nebo vzrostl, a za jaké období.</li>
        <li><strong>Nejvyšší zachycený kurz:</strong> kurz stoupl aspoň o {MIN_HIGH_PCT} % a je na nejvyšší hodnotě, jakou jsme v tom období při kontrolách zapsali (první zápis za maximum nepovažujeme).</li>
        <li>Pořadí: nejdřív rozdíly mezi kancelářemi, pak velké změny, pak nová maxima; uvnitř podle velikosti rozdílu. Nejvýš 6 položek, z každého zápasu jedna.</li>
        <li>Bereme jen aktuální kurzy z posledních kontrol. Na pořadí ani na to, kde je kurz vyšší, nemá vliv, se kterou kanceláří spolupracujeme.</li>
      </ul>
    </details>
  </section>

  <section class="wrap mt-16" aria-labelledby="h-next">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
      <div>
        <h2 id="h-next" class="m-0 flex items-center gap-2"><Art name={sport} size={34} />Nejbližší zápasy</h2>
        <p class="mt-2 mb-0 text-ink-2">Klikni na kurz a otevře se zápas u kanceláře. Zelený rámeček = tam vyplatí víc.</p>
      </div>
      <nav class="seg" aria-label="Sport">
        <a href="/" aria-current={sport === 'fotbal' ? 'page' : undefined}>Fotbal <span class="count num">{counts.fotbal}</span></a>
        <a href="/?sport=hokej" aria-current={sport === 'hokej' ? 'page' : undefined}>Hokej <span class="count num">{counts.hokej}</span></a>
      </nav>
    </div>
    {next.length ? <div class="grid gap-5 lg:grid-cols-2">{next.map((ev) => <Ticket ev={ev} books={up.books} now={t} cfg={cfg} place="home" />)}</div>
      : <p class="card p-5 m-0">Kurzy na nejbližší zápasy teď nemáme. Zkontrolujeme je znovu za pár minut.</p>}
    <p class="mt-6"><a href={`/kurzy/?sport=${sport}`} class="btn btn--ghost">Všechny zápasy ({sport === 'hokej' ? 'hokej' : 'fotbal'})<Icon name="arrow-right" size={16} /></a></p>
  </section>

  <section class="wrap mt-16" aria-labelledby="h-moves">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
      <div>
        <h2 id="h-moves" class="m-0 flex items-center gap-2"><Art name="radar" size={34} />Co se hýbe</h2>
        <p class="mt-2 mb-0 text-ink-2">Při každé kontrole si zapíšeme, jak se kurz od minulé změnil. Tady jsou největší změny{win ? ` ${win.since}` : ''}.</p>
      </div>
      <a href="/radar/" class="font-bold inline-flex items-center gap-1 min-h-[44px]">Všechny pohyby kurzů<Icon name="arrow-right" size={16} /></a>
    </div>
    {moves.length ? <div class="grid gap-4 lg:grid-cols-3">{moves.map((f) => <FindingCard f={f} now={t} checkedAt={checkedOf(f.books)} back="/" compact />)}</div>
      : <p class="card p-5 m-0">Kurzy si zapisujeme teprve chvíli. Jakmile se nějaký pohne, uvidíš to tady.</p>}
  </section>

  <section class="wrap mt-16" aria-label="Jak číst kurz">
    <HowOdds odds={ex?.v.favourite?.best ? ex.v.favourite.best.odds / 1000 : 1.85} />
  </section>

  <section class="wrap mt-16" aria-labelledby="h-books">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
      <div>
        <h2 id="h-books" class="m-0">Kde vsadit</h2>
        <p class="mt-2 mb-0 text-ink-2">Všechny kanceláře tady mají českou licenci. U každé píšeme, jestli sledujeme její kurzy.</p>
      </div>
      <a href="/sazkove-kancelare/" class="font-bold inline-flex items-center gap-1 min-h-[44px]">Porovnat kanceláře<Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {BOOKMAKERS.filter((b) => b.review === 'published').map((b) => (
        <a href={`/sazkove-kancelare/${b.id}/`} class="ticket no-underline text-ink p-5 flex flex-col gap-3">
          <BookLogo id={b.id} h={34} />
          <p class="m-0 font-display font-bold text-lg">{b.name}</p>
          <p class="m-0 text-ink-2">{b.oddsFeed === 'active' ? 'Kurzy sledujeme a porovnáváme.' : 'Kurzy zatím nesledujeme, ale můžeš tu vsadit.'}</p>
          <span class="mt-auto font-bold text-green-ink inline-flex items-center gap-1">Recenze {b.name}<Icon name="arrow-right" size={15} /></span>
        </a>
      ))}
    </div>
  </section>

  {sportList.length > 1 && (
    <section class="wrap mt-16" aria-labelledby="h-sporty">
      <h2 id="h-sporty" class="mb-2">Sporty</h2>
      <p class="mt-0 mb-5 text-ink-2">Fotbal a hokej, ale i tenis, basketbal, esporty, šipky a další. U každého zápasu vidíš kurzy Tipsportu a Chance vedle sebe.</p>
      <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
        {sportList.map((s) => <li><a class="chip" href={s.path}>{s.name}<span class="count num">{s.count}</span><span class="sr"> zápasů</span></a></li>)}
      </ul>
      <p class="mt-4"><a href="/sporty/" class="font-bold">Všechny sporty</a></p>
    </section>
  )}

  {comps.length > 0 && (
    <section class="wrap mt-16" aria-labelledby="h-comps">
      <h2 id="h-comps" class="mb-2">Podle soutěže</h2>
      <p class="mt-0 mb-5 text-ink-2">Největší soutěže, které právě mají zápasy.</p>
      <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
        {comps.map((c) => <li><a class="chip" href={`/souteze/${c.slug}/`}>{c.name}<span class="count num">{c.count}</span><span class="sr"> zápasů</span></a></li>)}
      </ul>
    </section>
  )}

  <section class="wrap mt-16" aria-labelledby="h-how">
    <h2 id="h-how" class="mb-6">Jak KurzovýRadar funguje</h2>
    <ol class="grid gap-5 md:grid-cols-3 list-none p-0 m-0">
      <li class="card p-5"><Art name="krok-kontrola" size={56} /><h3 class="mt-3 mb-1">1. Každých {cfg.importIntervalMin} minut kontrolujeme kurzy</h3><p class="m-0 text-ink-2">U Tipsportu a Chance na fotbal a hokej. Nemusíš nic obnovovat ani se registrovat.</p></li>
      <li class="card p-5"><Art name="krok-porovnani" size={56} /><h3 class="mt-3 mb-1">2. Dáme vedle sebe stejné sázky</h3><p class="m-0 text-ink-2">Jen stejný zápas a stejnou sázku. Kde kancelář vyplatí víc, označíme zeleně.</p></li>
      <li class="card p-5"><Art name="krok-historie" size={56} /><h3 class="mt-3 mb-1">3. Zapisujeme, co se mezi kontrolami změnilo</h3><p class="m-0 text-ink-2">Proto uvidíš, jestli kurz roste, nebo padá. Změny mezi kontrolami nevidíme, nic nedopočítáváme a nedáváme tipy.</p></li>
    </ol>
    <p class="mt-6"><a href="/metodika/">Podrobně: odkud bereme data</a></p>
  </section>

  <section class="wrap mt-16" aria-labelledby="h-guides">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
      <h2 id="h-guides" class="m-0">Jak na kurzy</h2>
      <a href="/pruvodce/" class="font-bold inline-flex items-center gap-1 min-h-[44px]">Všechny průvodce<Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {guides.slice(0, 3).map((g) => (
        <a href={`/pruvodce/${g.id}/`} class="card p-5 no-underline text-ink hover:bg-white">
          <Art name={`pruvodce-${g.id}`} size={64} />
          <h3 class="mt-3 mb-1">{g.data.title}</h3>
          <p class="m-0 text-ink-2">{g.data.lead}</p>
        </a>
      ))}
      <a href="/kalkulacky/" class="card p-5 no-underline text-ink hover:bg-white">
        <Art name="kalkulacka" size={64} />
        <h3 class="mt-3 mb-1">Kolik vyhraju?</h3>
        <p class="m-0 text-ink-2">Zadej sázku a kurz, spočítáme výhru i zisk.</p>
      </a>
    </div>
  </section>
</Base>
