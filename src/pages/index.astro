---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ticket from '../components/Ticket.astro';
import MoveItem from '../components/MoveItem.astro';
import BookLogo from '../components/BookLogo.astro';
import Icon from '../components/Icon.astro';
import CanvaIcon from '../components/CanvaIcon.astro';
import HowOdds from '../components/HowOdds.astro';
import Photo from '../components/Photo.astro';
import canva from '../data/canva.json';
import { BOOKMAKERS } from '../config/bookmakers';
import { COMPETITIONS } from '../config/competitions';
import { upcoming, radar, listable, lastCheck, mergeMoves, cfg as getCfg, now as getNow, cacheHeader } from '../lib/data';
import { int, time, dayKey } from '../lib/format';
import { ticketView } from '../lib/ticket';
import { WINDOWS } from '../server/view';

const [up, rd, guides] = await Promise.all([upcoming(), radar(), getCollection('pruvodce')]);
guides.sort((a, b) => a.data.order - b.data.order);
const t = getNow();
const cfg = getCfg();
const events = listable(up, t, cfg);
const sport = Astro.url.searchParams.get('sport') === 'hokej' ? 'hokej' : 'fotbal';
const soon = events.filter((e) => e.sport === sport && e.startAt <= t + 2 * 86400);
const next = (soon.length >= 4 ? soon : events.filter((e) => e.sport === sport)).slice(0, 6);
const checked = lastCheck(up);
const win = rd ? [...WINDOWS].reverse().find((w) => rd.windows[w.key].available) : undefined;
const moves = win && rd
  ? [...mergeMoves(rd.windows[win.key].drops.filter((m) => m.startAt > t)).slice(0, 2), ...mergeMoves(rd.windows[win.key].rises.filter((m) => m.startAt > t)).slice(0, 1)]
  : [];
const compCounts = new Map<string, number>();
for (const e of events) compCounts.set(e.comp, (compCounts.get(e.comp) ?? 0) + 1);
const comps = COMPETITIONS.filter((c) => compCounts.has(c.slug)).sort((a, b) => Number(!!b.top) - Number(!!a.top) || (compCounts.get(b.slug)! - compCounts.get(a.slug)!));
const counts = { fotbal: events.filter((e) => e.sport === 'fotbal').length, hokej: events.filter((e) => e.sport === 'hokej').length };
const today = events.filter((e) => dayKey(e.startAt) === dayKey(t)).length;
// Real example for the explainer: the first listed favourite, else a neutral 1,85.
const ex = next.map((e) => ({ e, v: ticketView(e, up.books, t, cfg) })).find((x) => x.v.favourite?.best);
Astro.response.headers.set('Cache-Control', cacheHeader());
---
<Base title="KurzovýRadar – kurzy na fotbal a hokej přehledně, i jak se mění"
  description="Kolik vyplácí Tipsport a Chance za fotbal a hokej a jestli kurz roste, nebo padá. Srozumitelně, bez registrace. Kurzy kontrolujeme každých 15 minut.">
  <section class="wrap pt-8 md:pt-14 grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
    <div>
      <p class="hand m-0 text-[1.6rem] -rotate-2 origin-left">fotbal & hokej, bez registrace</p>
      <h1 class="mt-2 mb-4 text-balance">Porovnej kurzy. Sleduj jejich pohyb.</h1>
      <p class="text-[1.2rem] max-w-[46ch] m-0">Uvidíš, kolik vyplatí Tipsport a Chance za fotbal a hokej a jestli kurz roste, nebo padá.</p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/kurzy/" class="btn">Porovnat kurzy<Icon name="arrow-right" size={18} /></a>
        <a href="/radar/" class="btn btn--ghost">Otevřít radar</a>
      </div>
      {checked && <p class="mt-6 mb-0 text-ink-2 flex flex-wrap items-center gap-x-2"><span class="inline-block w-2.5 h-2.5 rounded-full bg-green border-2 border-ink" aria-hidden="true"></span>Naposledy zkontrolováno v {time(checked)} · {int(events.length)} zápasů s kurzy{today ? `, z toho ${today} dnes` : ''}</p>}
    </div>
    <div class="relative">
      {'hero' in canva ? <CanvaIcon name="hero" size={520} eager class="w-full h-auto" alt="" />
        : <div class="card p-2.5 rotate-[1.5deg]"><div class="rounded-[8px] overflow-hidden border-2 border-ink aspect-[4/3]"><Photo slot="hero" priority sizes="(min-width: 1024px) 520px, 100vw" class="h-full" /></div></div>}
      {ex?.v.favourite?.best && (
        <div class="ticket max-w-[340px] mx-auto lg:mx-0 lg:absolute lg:-bottom-6 lg:-left-6 rotate-[-2deg] p-4">
          <p class="eyebrow m-0">{ex.e.compName}</p>
          <p class="font-display font-bold text-lg m-0 mt-1">{ex.e.home} vs {ex.e.away}</p>
          <p class="m-0 mt-2">Kurz na {ex.v.favourite.outcome === 'x' ? 'remízu' : ex.v.favourite.who}: <strong class="num">{(ex.v.favourite.best.odds / 1000).toFixed(2).replace('.', ',')}</strong></p>
          <p class="hand m-0 mt-1">100 Kč → {Math.round(ex.v.favourite.best.odds / 10)} Kč</p>
        </div>
      )}
    </div>
  </section>

  <section class="wrap mt-16" aria-labelledby="h-next">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
      <div>
        <h2 id="h-next" class="m-0 flex items-center gap-2"><CanvaIcon name={sport} size={34} />Nejbližší zápasy</h2>
        <p class="mt-2 mb-0 text-ink-2">Klikni na kurz a otevře se zápas u kanceláře. Zelený rámeček = tam vyplatí víc.</p>
      </div>
      <nav class="seg" aria-label="Sport">
        <a href="/" aria-current={sport === 'fotbal' ? 'page' : undefined}>Fotbal <span class="count num">{counts.fotbal}</span></a>
        <a href="/?sport=hokej" aria-current={sport === 'hokej' ? 'page' : undefined}>Hokej <span class="count num">{counts.hokej}</span></a>
      </nav>
    </div>
    {next.length ? <div class="grid gap-5 lg:grid-cols-2">{next.map((ev) => <Ticket ev={ev} books={up.books} now={t} cfg={cfg} place="home" />)}</div>
      : <p class="card p-5 m-0">Kurzy na nejbližší zápasy teď nemáme. Zkontrolujeme je znovu za pár minut.</p>}
    <p class="mt-6"><a href={`/kurzy/?sport=${sport}`} class="btn btn--ghost">Všechny zápasy ({sport === 'hokej' ? 'hokej' : 'fotbal'})<Icon name="arrow-right" size={16} /></a></p>
  </section>

  <section class="wrap mt-16" aria-labelledby="h-moves">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
      <div>
        <h2 id="h-moves" class="m-0 flex items-center gap-2"><CanvaIcon name="radar" size={34} />Co se hýbe</h2>
        <p class="mt-2 mb-0 text-ink-2">Když kancelář změní kurz, zapíšeme si to. Tady jsou největší změny{win ? ` ${win.since}` : ''}.</p>
      </div>
      <a href="/radar/" class="font-bold inline-flex items-center gap-1 min-h-[44px]">Všechny pohyby kurzů<Icon name="arrow-right" size={16} /></a>
    </div>
    {moves.length ? <ul class="grid gap-4 lg:grid-cols-3 list-none p-0 m-0">{moves.map((m) => <MoveItem m={m} now={t} windowLabel={win!.since} compact />)}</ul>
      : <p class="card p-5 m-0">Kurzy si zapisujeme teprve chvíli. Jakmile se nějaký pohne, uvidíš to tady.</p>}
  </section>

  <section class="wrap mt-16" aria-label="Jak číst kurz">
    <HowOdds odds={ex?.v.favourite?.best ? ex.v.favourite.best.odds / 1000 : 1.85} />
  </section>

  <section class="wrap mt-16" aria-labelledby="h-books">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
      <div>
        <h2 id="h-books" class="m-0">Kde vsadit</h2>
        <p class="mt-2 mb-0 text-ink-2">Všechny kanceláře tady mají českou licenci. U každé píšeme, jestli sledujeme její kurzy.</p>
      </div>
      <a href="/sazkove-kancelare/" class="font-bold inline-flex items-center gap-1 min-h-[44px]">Porovnat kanceláře<Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {BOOKMAKERS.filter((b) => b.review === 'published').map((b) => (
        <a href={`/sazkove-kancelare/${b.id}/`} class="ticket no-underline text-ink p-5 flex flex-col gap-3">
          <BookLogo id={b.id} h={34} />
          <p class="m-0 font-display font-bold text-lg">{b.name}</p>
          <p class="m-0 text-ink-2">{b.oddsFeed === 'active' ? 'Kurzy sledujeme a porovnáváme.' : 'Kurzy zatím nesledujeme, ale můžeš tu vsadit.'}</p>
          <span class="mt-auto font-bold text-green-ink inline-flex items-center gap-1">Recenze {b.name}<Icon name="arrow-right" size={15} /></span>
        </a>
      ))}
    </div>
  </section>

  {comps.length > 0 && (
    <section class="wrap mt-16" aria-labelledby="h-comps">
      <h2 id="h-comps" class="mb-2">Podle soutěže</h2>
      <p class="mt-0 mb-5 text-ink-2">Sledujeme hlavní fotbalové a hokejové soutěže.</p>
      <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
        {comps.map((c) => <li><a class="chip" href={`/souteze/${c.slug}/`}>{c.name}<span class="count num">{compCounts.get(c.slug)}</span><span class="sr"> zápasů</span></a></li>)}
      </ul>
    </section>
  )}

  <section class="wrap mt-16" aria-labelledby="h-how">
    <h2 id="h-how" class="mb-6">Jak KurzovýRadar funguje</h2>
    <ol class="grid gap-5 md:grid-cols-3 list-none p-0 m-0">
      <li class="card p-5"><CanvaIcon name="krok-kontrola" size={56} /><h3 class="mt-3 mb-1">1. Každých {cfg.importIntervalMin} minut kontrolujeme kurzy</h3><p class="m-0 text-ink-2">U Tipsportu a Chance na fotbal a hokej. Nemusíš nic obnovovat ani se registrovat.</p></li>
      <li class="card p-5"><CanvaIcon name="krok-porovnani" size={56} /><h3 class="mt-3 mb-1">2. Dáme vedle sebe stejné sázky</h3><p class="m-0 text-ink-2">Jen stejný zápas a stejnou sázku. Kde kancelář vyplatí víc, označíme zeleně.</p></li>
      <li class="card p-5"><CanvaIcon name="krok-historie" size={56} /><h3 class="mt-3 mb-1">3. Zapisujeme každou změnu</h3><p class="m-0 text-ink-2">Proto uvidíš, jestli kurz roste, nebo padá. Nic nedopočítáváme a nedáváme tipy.</p></li>
    </ol>
    <p class="mt-6"><a href="/metodika/">Podrobně: odkud bereme data</a></p>
  </section>

  <section class="wrap mt-16" aria-labelledby="h-guides">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-5">
      <h2 id="h-guides" class="m-0">Jak na kurzy</h2>
      <a href="/pruvodce/" class="font-bold inline-flex items-center gap-1 min-h-[44px]">Všechny průvodce<Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {guides.slice(0, 3).map((g) => (
        <a href={`/pruvodce/${g.id}/`} class="card p-5 no-underline text-ink hover:bg-white">
          <CanvaIcon name={`pruvodce-${g.id}`} size={64} />
          <h3 class="mt-3 mb-1">{g.data.title}</h3>
          <p class="m-0 text-ink-2">{g.data.lead}</p>
        </a>
      ))}
      <a href="/kalkulacky/" class="card p-5 no-underline text-ink hover:bg-white">
        <CanvaIcon name="kalkulacka" size={64} />
        <h3 class="mt-3 mb-1">Kolik vyhraju?</h3>
        <p class="m-0 text-ink-2">Zadej sázku a kurz, spočítáme výhru i zisk.</p>
      </a>
    </div>
  </section>
</Base>
