---
import Base from '../../layouts/Base.astro';
import MoveItem from '../../components/MoveItem.astro';
import BookLogo from '../../components/BookLogo.astro';
import FreshNote from '../../components/FreshNote.astro';
import Art from '../../components/Art.astro';
import { upcoming, radar, mergeMoves, cfg as getCfg, now as getNow, cacheHeader } from '../../lib/data';
import { odds as fmt, pct, kickoff, dateTime } from '../../lib/format';
import { WINDOWS, type WindowKey } from '../../server/view';

const [up, rd] = await Promise.all([upcoming(), radar()]);
const t = getNow();
const cfg = getCfg();
const q = Astro.url.searchParams;
const available = WINDOWS.filter((w) => rd?.windows[w.key].available);
const req = WINDOWS.find((w) => w.key === q.get('obdobi'));
const win = req && rd?.windows[req.key].available ? req : available[available.length - 1];
const VIEWS = [
  { key: 'poklesy', label: 'Kurz klesl' },
  { key: 'rusty', label: 'Kurz stoupl' },
  { key: 'rozdily', label: 'Tipsport vs. Chance' },
  { key: 'maxima', label: 'Na maximu' },
] as const;
const view = VIEWS.find((v) => v.key === q.get('pohled'))?.key ?? 'poklesy';
const w = win && rd ? rd.windows[win.key as WindowKey] : null;
const notStarted = <T extends { startAt: number }>(l: T[]) => l.filter((m) => m.startAt > t);
const items = mergeMoves(!w ? [] : view === 'poklesy' ? notStarted(w.drops) : view === 'rusty' ? notStarted(w.rises) : view === 'maxima' ? notStarted(w.highs) : []);
const diffs = rd ? notStarted(rd.diffs) : [];
const href = (k: string, v: string) => { const p = new URLSearchParams(q); p.set(k, v); return `/radar/?${p}`; };
const filtered = q.size > 0;
const since = up.stats.firstRecordAt;
const EXPLAIN: Record<string, string> = {
  poklesy: 'Kancelář teď za tenhle výsledek vyplácí méně než dřív. Často to znamená, že na něj lidé sází, nebo že se objevila nová informace (zranění, sestava). Není to tip a neznamená to, že to vyjde.',
  rusty: 'Kancelář teď za tenhle výsledek vyplácí víc než dřív. Obvykle mu věří méně než předtím. Vyšší kurz znamená vyšší výhru, ne vyšší šanci.',
  rozdily: 'Tady se Tipsport a Chance liší. Kde je kurz vyšší, tam za stejnou sázku dostaneš víc. Většinou mají obě kanceláře kurzy stejné, takže rozdílů bývá málo.',
  maxima: 'Kurz za zvolené období stoupl a teď je nejvýš, kolik jsme ho viděli.',
};
Astro.response.headers.set('Cache-Control', cacheHeader());
---
<Base title={filtered ? 'Pohyby kurzů – výběr | KurzovýRadar' : 'Pohyby kurzů – kde kurz klesl a kde stoupl | KurzovýRadar'}
  description="Kde kurzy Tipsportu a Chance na fotbal a hokej za poslední hodinu, 6 nebo 24 hodin klesly nebo stouply. Srozumitelně, s časy zápisů a malým grafem."
  canonical="/radar/" noindex={filtered} crumbs={[{ name: 'Pohyby kurzů', url: '/radar/' }]}>
  <div class="wrap pt-6">
    <div class="flex items-start gap-4">
      <div class="flex-1">
        <h1 class="m-0">Pohyby kurzů</h1>
        <p class="text-[1.1rem] max-w-[60ch] mt-3 mb-3">Kancelář mění kurzy i několikrát denně. Každou změnu si zapíšeme. Tady jsou ty největší u zápasů, které ještě nezačaly.</p>
        <FreshNote books={up.books} now={t} cfg={cfg} />
      </div>
      <Art name="radar" size={110} class="hidden md:block" />
    </div>

    <div class="mt-6 grid gap-3">
      <nav class="seg" aria-label="Co chceš vidět">
        {VIEWS.map((v) => <a href={href('pohled', v.key)} aria-current={view === v.key ? 'page' : undefined}>{v.label}</a>)}
      </nav>
      {view !== 'rozdily' && available.length > 0 && (
        <nav class="seg" aria-label="Za jak dlouho">
          {available.map((x) => <a href={href('obdobi', x.key)} aria-current={win?.key === x.key ? 'page' : undefined}>za {x.label}</a>)}
        </nav>
      )}
    </div>

    <aside class="note-box mt-5 max-w-[760px]">
      <p class="m-0"><strong>Co to znamená?</strong> {EXPLAIN[view]}</p>
    </aside>

    <div class="mt-6">
      {view === 'rozdily' ? (
        diffs.length ? (
          <ul class="grid gap-5 lg:grid-cols-2 list-none p-0 m-0">
            {diffs.map((d) => (
              <li class="ticket p-4 grid gap-2">
                <p class="m-0 text-[0.95rem] text-ink-2"><span class="num font-bold text-ink">{kickoff(d.startAt, t)}</span> · {d.compName}</p>
                <h2 class="text-[1.15rem] m-0"><a href={d.url} class="text-ink no-underline hover:underline">{d.home} vs {d.away}</a></h2>
                <p class="m-0">Na <strong>{d.outcome === '1' ? d.home : d.outcome === '2' ? d.away : 'remízu'}</strong> vyplatí víc {d.high.book === 'tipsport' ? 'Tipsport' : 'Chance'}: o {pct(d.pct, false)} víc za stejnou sázku.</p>
                <div class="flex items-center gap-3 flex-wrap">
                  <span class="flex items-center gap-2"><BookLogo id={d.high.book} h={22} /><span class="odd odd--best !min-h-0 !py-1"><span class="odd__val">{fmt(d.high.odds)}</span></span></span>
                  <span class="flex items-center gap-2"><BookLogo id={d.low.book} h={22} /><span class="odd !min-h-0 !py-1"><span class="odd__val text-ink-2">{fmt(d.low.odds)}</span></span></span>
                </div>
              </li>
            ))}
          </ul>
        ) : <div class="card p-6 max-w-[640px]"><p class="m-0 text-lg font-bold">Teď mají obě kanceláře všude stejné kurzy.</p><p class="mt-2 mb-0">Tipsport a Chance patří do stejné skupiny a kurzy mají většinou shodné. Jakmile se někde rozejdou, uvidíš to tady.</p></div>
      ) : !win ? (
        <div class="card p-6 max-w-[640px]"><p class="m-0 text-lg font-bold">Pro tohle zatím nemáme dost zápisů.</p><p class="mt-2 mb-0">{since ? `Kurzy si zapisujeme od ${dateTime(since)}. První pohyby uvidíš zhruba hodinu po začátku.` : 'Zapisování ještě nezačalo.'}</p></div>
      ) : items.length ? (
        <ul class="grid gap-5 lg:grid-cols-2 list-none p-0 m-0">{items.map((m) => <MoveItem m={m} now={t} windowLabel={win.since} />)}</ul>
      ) : <div class="card p-6 max-w-[640px]"><p class="m-0 text-lg font-bold">{win.since.charAt(0).toUpperCase() + win.since.slice(1)} se nic takového nestalo.</p><p class="mt-2 mb-0">Zkus delší období nebo druhou záložku.</p></div>}
    </div>

    <section class="mt-14 card p-5 md:p-7 prose max-w-none" aria-labelledby="h-how-radar">
      <h2 id="h-how-radar" class="!mt-0">Jak to počítáme</h2>
      <ul>
        <li>Porovnáme dnešní kurz s posledním kurzem, který jsme zapsali před začátkem období. Změna = (nový kurz ÷ starý kurz − 1) × 100 %.</li>
        <li>Když kurz sledujeme kratší dobu, změnu nepočítáme. Chybějící zápis není nulová změna.</li>
        <li>Bereme jen zápasy, které ještě nezačaly, a jen kurzy, které kancelář právě nabízí.</li>
      </ul>
      <p>Víc v článku <a href="/pruvodce/pohyb-kurzu/">Co znamená pohyb kurzu</a> a v <a href="/metodika/">metodice</a>.</p>
    </section>
  </div>
</Base>
