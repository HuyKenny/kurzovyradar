---
import Base from '../../layouts/Base.astro';
import EventList from '../../components/EventList.astro';
import FreshNote from '../../components/FreshNote.astro';
import Icon from '../../components/Icon.astro';
import { SPORTS, competitionBySlug, stubColor, isSport, type Sport } from '../../config/competitions';
import { competitionsIn } from '../../lib/catalog';
import { COMP_EXTRA } from '../../config/comp-extra';
import { ON_SPORTSTREAMY, ON_ZIVEPRENOSY, SPORTSTREAMY, ZIVEPRENOSY, ON_FREESPINY } from '../../config/sister';
import PicksStrip from '../../components/PicksStrip.astro';
import { picks as pickList } from '../../lib/picks';
import { E, upcoming, radar, listable, cfg as getCfg, now as getNow, cacheHeader } from '../../lib/data';

const slug = Astro.params.slug ?? '';
const [up, rd] = await Promise.all([upcoming(), radar()]);
const t = getNow();
const cfg = getCfg();
const all = listable(up, t, cfg);
const events = all.filter((e) => e.comp === slug);
// Curated competitions have their own wording; every other one is named after the platform (see server/normalize/competition.ts).
const cur = competitionBySlug(slug);
let c: { slug: string; name: string; sport: Sport; country: string; color: string; intro: string } | null = null;
if (cur) c = { slug, name: cur.name, sport: cur.sport, country: cur.country, color: cur.color, intro: cur.intro };
else {
  const found = events[0] ? { name: events[0].compName, sport: events[0].sport } : await E.DB.prepare('SELECT name, sport FROM competitions WHERE slug = ?').bind(slug).first<{ name: string; sport: string }>();
  if (found && isSport(found.sport)) c = { slug, name: found.name, sport: found.sport, country: '', color: stubColor(slug, found.sport), intro: `Zápasy soutěže ${found.name} (${SPORTS[found.sport].name.toLowerCase()}).` };
}
if (!c) return Astro.rewrite('/404/');
const S = SPORTS[c.sport];
const extra = COMP_EXTRA[c.slug];
const siblings = competitionsIn(all.filter((e) => e.sport === c!.sport)).filter((x) => x.slug !== c!.slug).slice(0, 30);
const chosen = pickList(up, rd, t, cfg, 3, { filter: (e) => e.comp === c!.slug });
Astro.response.headers.set('Cache-Control', cacheHeader());
---
<Base title={`${c.name} – kurzy a jejich vývoj | KurzovýRadar`}
  description={`Kurzy na zápasy soutěže ${c.name}${c.country ? ` (${c.country})` : ''}: Tipsport a Chance vedle sebe, nejvyšší kurz zvýrazněný a zaznamenané změny kurzů.`}
  noindex={events.length === 0} crumbs={[{ name: S.name, url: S.path }, { name: c.name, url: `/souteze/${c.slug}/` }]}
  schema={extra ? [{ '@type': 'FAQPage', mainEntity: extra.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []}>
  <div class="wrap pt-6">
    <p class="eyebrow m-0">{S.name}{c.country && <> · {c.country}</>}</p>
    <h1 class="mt-2 mb-0"><span class="inline-block px-3 rounded-[10px] border-2 border-ink" style={`background:${c.color}`}>{c.name}</span>: kurzy</h1>
    <p class="text-[1.1rem] max-w-[64ch] mt-3 mb-3">{c.intro} U každého zápasu vidíš kurzy Tipsportu a Chance vedle sebe.</p>
    <button type="button" hidden class="btn btn--ghost btn--sm mb-3" data-follow-comp={c.slug} data-name={c.name} aria-pressed="false"><Icon name="star" size={16} /><span data-follow-label>Sledovat soutěž</span></button>
    <FreshNote books={up.books} now={t} cfg={cfg} />
    {events.length > 0 && <PicksStrip picks={chosen} now={t} back={`/souteze/${c.slug}/`} scope="v soutěži" />}
    <div class="mt-8">
      {events.length ? <EventList events={events} books={up.books} now={t} cfg={cfg} place={`soutez-${c.slug}`} showComp={false} />
        : <div class="card p-6 max-w-[640px]"><p class="m-0 text-lg font-bold">Teď tu žádný zápas není.</p><p class="mt-2 mb-0">Kanceláře zatím nevypsaly kurzy na další kolo (třeba kvůli přestávce v sezóně). Jakmile je vypíšou, uvidíš je tady. Mezitím se podívej na <a href="/souteze/">všechny soutěže</a>.</p></div>}
    </div>
    <p class="mt-10 max-w-[64ch]">Kurzy na {c.name} sledujeme u Tipsportu a Chance a každé čtvrt hodiny je znovu porovnáváme. U zápasu uvidíš, kdo nabízí vyšší kurz a jak se kurz od začátku sledování měnil. <a href="/pruvodce/porovnavani-stejnych-sazek/">Jak porovnání čteme</a>.</p>
    {(ON_SPORTSTREAMY[c.slug] || ON_ZIVEPRENOSY[c.slug]) && (
      <p class="mt-4 max-w-[64ch]">
        {ON_SPORTSTREAMY[c.slug] && <>Kde zápasy {c.name} sledovat a jaký je program přenosů najdeš na <a href={`${SPORTSTREAMY}${ON_SPORTSTREAMY[c.slug]}`}>sportstreamy.cz</a> (náš sesterský web). </>}
        {ON_ZIVEPRENOSY[c.slug] && <>Slovenské vysielanie: <a href={`${ZIVEPRENOSY}${ON_ZIVEPRENOSY[c.slug]}`} rel="nofollow noopener" hreflang="sk" lang="sk">ziveprenosy.sk</a>.</>}
      </p>
    )}
    {ON_FREESPINY[c.slug] && <p class="mt-4 max-w-[64ch]">Láká tě při zápase nabídka bonusu? Než kliknete, přečti si, jak se liší <a href={ON_FREESPINY[c.slug]!.url}>{ON_FREESPINY[c.slug]!.anchor}</a> (sesterský web FreeSpiny.eu).</p>}
    {extra && (
      <section class="mt-10 max-w-[72ch] prose" aria-labelledby="h-about">
        <h2 id="h-about">O soutěži {c.name}</h2>
        {extra.intro.map((p) => <p>{p}</p>)}
        <h2>Časté otázky</h2>
        {extra.faq.map((f) => <details class="faq"><summary class="font-display font-bold cursor-pointer">{f.q}</summary><p class="mt-2">{f.a}</p></details>)}
      </section>
    )}
    <nav class="mt-12" aria-labelledby="h-sib">
      <h2 id="h-sib" class="text-xl">Další soutěže – {S.name.toLowerCase()}</h2>
      <ul class="flex flex-wrap gap-2 list-none p-0 m-0 mt-3">{siblings.map((s) => <li><a class="chip" href={`/souteze/${s.slug}/`}>{s.name}<span class="count num">{s.count}</span></a></li>)}</ul>
    </nav>
  </div>
</Base>
