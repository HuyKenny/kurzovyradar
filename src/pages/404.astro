---
import Base from '../layouts/Base.astro';
export const prerender = true;
---
<Base title="Stránka nenalezena | KurzovýRadar" description="Tahle stránka neexistuje." noindex>
  <div class="wrap pt-12 max-w-[720px]">
    <p class="hand m-0 text-[1.6rem]">404 · tady nic není</p>
    <h1 class="mt-2">Tuhle stránku jsme nenašli</h1>
    <p class="text-[1.1rem]">Možná se zápas už odehrál a jeho stránku jsme smazali. Nebo je v adrese překlep.</p>
    <div class="flex flex-wrap gap-3 mt-6"><a class="btn" href="/kurzy/">Dnešní kurzy</a><a class="btn btn--ghost" href="/hledat/">Hledat zápas</a></div>
  </div>
</Base>
