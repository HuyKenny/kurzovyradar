---
import Base from '../layouts/Base.astro';
export const prerender = true;
---
<Base title="Stránka nenalezena | KurzovýRadar" description="Tahle stránka neexistuje." noindex>
  <div class="wrap pt-12 max-w-[720px]">
    <p class="eyebrow m-0">Chyba 404</p>
    <h1 class="mt-2">Tahle stránka neexistuje</h1>
    <p class="text-ink-2">Zápas mohl proběhnout a jeho stránka už není k dispozici, nebo je adresa chybná.</p>
    <div class="flex flex-wrap gap-3 mt-6"><a class="btn" href="/kurzy/">Srovnání kurzů</a><a class="btn btn--ghost" href="/">Úvod</a></div>
  </div>
</Base>
