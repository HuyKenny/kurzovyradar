---
import Article from '../../components/Article.astro';
import BookLogo from '../../components/BookLogo.astro';
import Icon from '../../components/Icon.astro';
import { BOOK } from '../../config/bookmakers';
import { REVIEWS, SECTION_TITLES, type SectionKey } from '../../config/reviews';
import BonusCard from '../../components/BonusCard.astro';
import { bonusOf } from '../../config/bonuses';
import { cacheHeader, cfg as getCfg } from '../../lib/data';
import { REVIEW_ON_KRATKERECENZE } from '../../config/sister';
// Server-rendered (not prerendered): the bonus box shows figures only while the check is recent, which depends on today's date.
// Sazkabet is Allwyn's betting brand, not a bookmaker of its own: its old URL moves to Allwyn for good.
if (Astro.params.slug === 'sazkabet') return Astro.redirect('/sazkove-kancelare/allwyn/', 301);
const r = REVIEWS.find((x) => x.id === Astro.params.slug && BOOK[x.id].review !== 'none' && BOOK[x.id].review !== 'draft');
if (!r) return Astro.rewrite('/404/');
const b = BOOK[r.id];
const info = b.review === 'info';
const bonus = b.affiliate === 'approved' ? bonusOf(b.id) : undefined;
Astro.response.headers.set('Cache-Control', cacheHeader()); // factual overview: no rating, no bonus figures, no partner link
const checked = new Date(r.checked);
const sections = (Object.keys(SECTION_TITLES) as SectionKey[]).filter((k) => r.more?.[k]?.length);
const stripLabel = (s: string) => s.replace(/[.!?]+$/, '');
// FAQ from confirmed points only: each answer is the same visible text as in the section below.
const faqOf = (k: SectionKey, q: string) => r.more?.[k]?.length ? [{ q, a: r.more[k]!.map((p) => stripLabel(p.text)).join('. ') + '.' }] : [];
const faq = [
  ...faqOf('registrace', `Jak se zaregistrovat ${b.locative}?`),
  ...faqOf('aplikace', `Má ${b.name} mobilní aplikaci?`),
  ...faqOf('platby', `Jak se u ${b.name} vkládá a vybírá?`),
  { q: `Je ${b.name} legální v ČR?`, a: `${r.operator} (IČ ${r.ico}) je podle seznamu Ministerstva financí ČR držitelem povolení. Seznam je uvedený ve zdrojích níže.` },
  ...(b.oddsFeed === 'active' ? [{ q: `Porovnává KurzovýRadar kurzy ${b.name}?`, a: `Ano, kurzy kontrolujeme každých ${getCfg().importIntervalMin} minut a ukazujeme je u každého zápasu vedle ostatních kanceláří.` }] : [{ q: `Porovnává KurzovýRadar kurzy ${b.name}?`, a: 'Zatím ne, kurzy této kanceláře nemáme připojené, takže je ve srovnání nebudeš hledat.' }]),
];
---
<Article art="kancelar" title={info ? `${b.name}: přehled sázkové kanceláře` : `${b.alias ? `${b.name} (${b.alias})` : b.name}: recenze sázkové kanceláře`} metaTitle={info ? `${b.name} – přehled, provozovatel a licence | KurzovýRadar` : `${b.alias ? `${b.name} (${b.alias})` : b.name} – recenze, licence a kurzy | KurzovýRadar`}
  description={`${b.name}: provozovatel ${r.operator}, licence Ministerstva financí, nabídka a omezení. ${b.oddsFeed === 'active' ? 'Kurzy sledujeme a porovnáváme.' : 'Kurzy zatím nesledujeme.'}`}
  lead={r.summary} crumbs={[{ name: 'Kde vsadit', url: '/sazkove-kancelare/' }, { name: b.name, url: `/sazkove-kancelare/${b.id}/` }]}
  published={checked} updated={checked} checked={checked} schemaType="Article" faq={faq}>
  <div class="not-prose flex flex-wrap items-center gap-4">
    <BookLogo id={b.id} h={40} lazy={false} />
    {b.affiliate === 'approved' && <a class="btn" href={`/go/${b.id}/?p=recenze`} rel="sponsored nofollow">Přejít na {r.web}<Icon name="external-link" size={16} /></a>}
    {info && b.site && <a class="btn btn--ghost" href={b.site} rel="nofollow noopener" target="_blank">Oficiální web {r.web}<Icon name="external-link" size={16} /></a>}
  </div>
  {bonus && <div class="not-prose mt-6 max-w-[720px]"><BonusCard b={bonus} placement="bonus-recenze" /></div>}
  <div class="strucne not-prose mt-6">
    <p class="m-0 font-display font-bold text-lg">V kostce</p>
    <ul class="list-disc pl-5 mt-2 mb-0 grid gap-1">{r.inShort.map((x) => <li>{x}</li>)}</ul>
  </div>
  <h2>Základní údaje</h2>
  <table>
    <tbody>
      <tr><th scope="row">Provozovatel</th><td>{r.ico === '–' ? r.operator : `${r.operator}, IČ ${r.ico}`}</td></tr>
      {r.seat !== '–' && <tr><th scope="row">Sídlo</th><td>{r.seat}</td></tr>}
      <tr><th scope="row">Povolení</th><td>{r.licence}</td></tr>
      <tr><th scope="row">Web</th><td>{r.web}</td></tr>
      {r.facts.map((f) => <tr><th scope="row">{f.label}</th><td>{f.value}</td></tr>)}
    </tbody>
  </table>
  <h2>Na KurzovémRadaru</h2>
  <p>{r.onSite} {b.oddsFeed === 'active' && <a href="/kurzy/">Srovnání kurzů</a>}</p>
  <h2>{info ? 'Co kancelář uvádí o své nabídce' : 'Co nabízí'}</h2>
  <ul>{r.features.map((f) => <li>{f}</li>)}</ul>
  {sections.map((k) => (<>
    <h2>{SECTION_TITLES[k]}</h2>
    <ul>{r.more![k]!.map((p) => <li>{p.text}{p.url && <> <a href={p.url} rel="nofollow noopener" target="_blank" class="text-sm">zdroj</a></>}</li>)}</ul>
  </>))}
  {r.unverified && r.unverified.length > 0 && (<>
    <h2>Co jsme neověřili</h2>
    <p>Tohle jsme hledali a nepotvrdili jsme to z oficiálních zdrojů, proto to tady není. Chybějící údaj neznamená, že to kancelář nemá.</p>
    <ul>{r.unverified.map((u) => <li>{u}</li>)}</ul>
  </>)}
  {info ? (
    <p class="text-sm text-ink-2">Tohle není recenze: kancelář jsme netestovali, nehodnotíme ji a neuvádíme bonusy. {r.partnerNote ?? 'S touto kanceláří nespolupracujeme a odkaz na její web není partnerský.'} Údaje jsme zkontrolovali {checked.toLocaleDateString('cs-CZ')}, podmínky a nabídka se mění. Jak pracujeme s fakty, popisuje <a href="/metodika/">metodika</a>. Další kanceláře najdeš ve <a href="/sazkove-kancelare/srovnani/">srovnání</a>.</p>
  ) : (<>
  <h2>Výhody a omezení</h2>
  <div class="not-prose grid gap-4 sm:grid-cols-2">
    <div class="card p-4"><h3 class="text-base m-0 mb-2 flex items-center gap-1.5"><Icon name="arrow-up" size={16} class="text-up" />Výhody</h3><ul class="list-disc pl-5 m-0 grid gap-1">{r.pros.map((p) => <li>{p}</li>)}</ul></div>
    <div class="card p-4"><h3 class="text-base m-0 mb-2 flex items-center gap-1.5"><Icon name="minus" size={16} class="text-down" />Omezení</h3><ul class="list-disc pl-5 m-0 grid gap-1">{r.limits.map((p) => <li>{p}</li>)}</ul></div>
  </div>
  <p class="text-sm text-ink-2">Nehodnotíme hvězdičkami. Vstupní bonus porovnáváme na stránce <a href="/bonusy/">Bonusy</a>. Podmínky bonusů a akcí se mění, platné znění najdeš vždy přímo u kanceláře.{b.affiliate === 'approved' && ' Odkaz na kancelář je partnerský – při registraci můžeme dostat provizi.'}</p>
  </>)}
  <h2>Další na KurzovémRadaru</h2>
  <ul>
    {bonus && <li><a href={`/bonusy/${b.id}/`}>Vstupní bonus {b.name}: podmínky a prosázení</a></li>}
    <li><a href="/sazkove-kancelare/srovnani/">Srovnání všech kanceláří v tabulce</a></li>
    <li><a href="/sazkove-kancelare/legalni/">Legální sázkové kanceláře podle Ministerstva financí</a></li>
    {(r.id === 'tipsport' || r.id === 'chance') && <li><a href="/sazkove-kancelare/tipsport-vs-chance/">Tipsport vs Chance</a></li>}
    <li><a href="/pruvodce/jak-poznat-legalni-sazkovou-kancelar/">Jak poznat legální sázkovou kancelář</a></li>
    <li><a href="/pojem/cashout/">Co je cashout</a></li>
    {REVIEW_ON_KRATKERECENZE[b.id] && <li>Na našem sesterském webu: <a href={REVIEW_ON_KRATKERECENZE[b.id]!.url}>{REVIEW_ON_KRATKERECENZE[b.id]!.anchor}</a></li>}
  </ul>
  <h2>Zdroje</h2>
  <ul>{r.sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a></li>)}</ul>
</Article>
