---
import Base from '../../layouts/Base.astro';
import EventOdds from '../../components/EventOdds.astro';
import Icon from '../../components/Icon.astro';
import { COMPETITIONS } from '../../config/competitions';
import { upcoming, listable, cfg as getCfg, now as getNow } from '../../lib/data';

const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60);
const fold = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
const f = fold(q);
const up = await upcoming();
const t = getNow();
const cfg = getCfg();
const comps = f.length >= 2 ? COMPETITIONS.filter((c) => fold(`${c.name} ${c.country}`).includes(f)) : [];
const events = f.length >= 2 ? listable(up, t, cfg).filter((e) => fold(`${e.home} ${e.away} ${e.compName}`).includes(f)).slice(0, 30) : [];
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=120');
---
<Base title={q ? `Hledání: ${q} | KurzovýRadar` : 'Hledání | KurzovýRadar'} description="Hledání týmů, soutěží a zápasů s kurzy." noindex crumbs={[{ name: 'Hledání', url: '/hledat/' }]}>
  <div class="wrap pt-6 max-w-[980px]">
    <h1 class="m-0">Hledání</h1>
    <form action="/hledat/" method="get" role="search" class="mt-4 flex gap-2 max-w-[620px]">
      <label for="q-page" class="sr">Tým, soutěž nebo zápas</label>
      <div class="relative flex-1"><Icon name="search" size={18} class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-3 pointer-events-none" />
        <input id="q-page" name="q" type="search" value={q} minlength="2" required placeholder="Tým, soutěž nebo zápas" class="w-full min-h-[48px] pl-10 pr-3 rounded-[11px] border border-line-2 bg-surface text-base" /></div>
      <button class="btn" type="submit">Hledat</button>
    </form>
    {q && f.length < 2 && <p class="mt-6 text-ink-2">Zadejte aspoň 2 znaky.</p>}
    {comps.length > 0 && (
      <section class="mt-8"><h2 class="text-lg">Soutěže</h2>
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0 mt-3">{comps.map((c) => <li><a class="chip" href={`/souteze/${c.slug}/`}>{c.name}</a></li>)}</ul></section>
    )}
    {f.length >= 2 && (
      <section class="mt-8"><h2 class="text-lg">Zápasy</h2>
        {events.length ? <div class="grid gap-3 mt-3">{events.map((e) => <EventOdds ev={e} books={up.books} now={t} cfg={cfg} place="hledani" />)}</div>
          : <p class="text-ink-2 mt-2">Žádný nadcházející zápas s kurzy neodpovídá hledání „{q}“.</p>}
      </section>
    )}
  </div>
</Base>
