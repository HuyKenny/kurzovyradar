---
import { getCollection } from 'astro:content';
import Article from '../../components/Article.astro';
import Icon from '../../components/Icon.astro';
export const prerender = true;
const guides = (await getCollection('pruvodce')).sort((a, b) => a.data.order - b.data.order);
---
<Article title="Průvodce kurzovým sázením" metaTitle="Průvodce kurzy – jak číst, porovnávat a sledovat kurzy | KurzovýRadar"
  description="Srozumitelní průvodci: jak fungují desetinné kurzy, co znamená pohyb kurzu, jak porovnávat stejné sázky a jak KurzovýRadar zpracovává data."
  lead="Krátké a věcné vysvětlení kurzů. Žádné tipy ani zaručené strategie." crumbs={[{ name: 'Průvodce', url: '/pruvodce/' }]} photo>
  <ul class="not-prose grid gap-3 sm:grid-cols-2 list-none p-0 max-w-[900px]">
    {guides.map((g) => (
      <li><a href={`/pruvodce/${g.id}/`} class="card p-5 h-full flex flex-col no-underline text-ink hover:border-blue transition-colors">
        <Icon name="book-open" size={20} class="text-teal" />
        <h2 class="text-lg mt-3 mb-1">{g.data.title}</h2>
        <p class="m-0 text-ink-2 text-[15px]">{g.data.lead}</p>
      </a></li>
    ))}
    <li><a href="/kalkulacky/" class="card p-5 h-full flex flex-col no-underline text-ink hover:border-blue transition-colors">
      <Icon name="calculator" size={20} class="text-teal" />
      <h2 class="text-lg mt-3 mb-1">Kalkulačky kurzů</h2>
      <p class="m-0 text-ink-2 text-[15px]">Výplata a zisk, implikovaná pravděpodobnost a srovnání dvou kurzů.</p>
    </a></li>
  </ul>
</Article>
