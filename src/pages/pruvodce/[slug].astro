---
import { getCollection, render } from 'astro:content';
import Article from '../../components/Article.astro';
export const prerender = true;
export async function getStaticPaths() {
  const all = (await getCollection('pruvodce')).sort((a, b) => a.data.order - b.data.order);
  return all.map((g) => ({ params: { slug: g.id }, props: { g, others: all.filter((x) => x.id !== g.id) } }));
}
const { g, others } = Astro.props;
const { Content } = await render(g);
---
<Article title={g.data.title} metaTitle={`${g.data.title} | KurzovýRadar`} description={g.data.description} lead={g.data.lead}
  crumbs={[{ name: 'Průvodce', url: '/pruvodce/' }, { name: g.data.title, url: `/pruvodce/${g.id}/` }]}
  published={g.data.published} updated={g.data.updated} checked={g.data.checked}>
  <Content />
  <aside slot="after" class="mt-12 max-w-[72ch]" aria-labelledby="h-more">
    <h2 id="h-more" class="text-lg">Další průvodci</h2>
    <ul class="mt-3 grid gap-2 list-none p-0">{others.map((o) => <li><a href={`/pruvodce/${o.id}/`} class="font-semibold">{o.data.title}</a></li>)}</ul>
    <p class="mt-6 text-sm text-ink-2">Sázení je jen pro dospělé. Kurz není předpověď výsledku. <a href="/odpovedne-hrani/">Odpovědné hraní</a></p>
  </aside>
</Article>
